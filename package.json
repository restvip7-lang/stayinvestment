{
  "name": "stayinvestment",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/cache-headers.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "fixtures": "NODE_USE_ENV_PROXY=1 node --no-warnings scripts/fetch-fixtures.mjs",
    "portfolio-sample": "NODE_USE_ENV_PROXY=1 node --no-warnings scripts/portfolio-sample.mjs",
    "import-legacy": "NODE_USE_ENV_PROXY=1 node --no-warnings scripts/import-legacy.mjs",
    "import-legacy-i18n": "NODE_USE_ENV_PROXY=1 node --no-warnings scripts/import-legacy-i18n.mjs",
    "start": "HOST=${HOST:-127.0.0.1} PORT=${PORT:-4330} node ./dist/server/entry.mjs",
    "build:vercel": "STAY_TARGET=vercel astro build && node scripts/cache-headers.mjs",
    "localize-media": "NODE_USE_ENV_PROXY=1 node --no-warnings scripts/localize-media.mjs && node --no-warnings scripts/optimize-images.mjs",
    "optimize-images": "node --no-warnings scripts/optimize-images.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.14",
    "@astrojs/vercel": "^11.0.22",
    "@tailwindcss/vite": "^4.3.5",
    "@vercel/functions": "^3.11.3",
    "astro": "^7.4.13",
    "tailwindcss": "^4.3.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^22.20.5",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
