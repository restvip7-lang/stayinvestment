# Публичный API новостей (админка Stay Property)
STAY_CONTENT_API=https://admin.stayproperty.com
# Куда пересылать заявки с форм (вебхук CRM / Telegram-бота). Пусто — заявки только пишутся в лог.
LEAD_WEBHOOK_URL=
# Секрет для /api/revalidate (Authorization: Bearer ...). CRON_SECRET — запасной секрет, необязателен.
REVALIDATE_SECRET=
# 0 — открыть сайт для индексации. По умолчанию закрыт (staging).
STAY_NOINDEX=1
