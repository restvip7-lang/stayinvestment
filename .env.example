# Публичный API новостей (админка Stay Property)
STAY_CONTENT_API=https://admin.stayproperty.com
# Куда пересылать заявки с форм (вебхук CRM / Telegram-бота). Пусто — заявки только пишутся в лог.
LEAD_WEBHOOK_URL=
# Секрет для /api/revalidate (Authorization: Bearer ...). CRON_SECRET — запасной секрет: на Vercel выставляется сам, на своём сервере необязателен.
REVALIDATE_SECRET=
# 0 — открыть сайт для индексации. По умолчанию закрыт (staging).
STAY_NOINDEX=1
# Свой сервер (npm start): адрес и порт Node.js-приложения за nginx
HOST=127.0.0.1
PORT=4330
# Свой сервер: папка для кэша сжатых картинок новостей (по умолчанию .cache/img в папке проекта)
IMG_CACHE_DIR=
