---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import InvestorCabinetMock from '../../components/InvestorCabinetMock.astro';
import Faq from '../../components/Faq.astro';
import LeadSection from '../../components/LeadSection.astro';
import { langOf, useT } from '../../i18n';

const lang = langOf(Astro.locals);
const tr = useT(lang);
const features = [
  { icon: 'doc', title: tr("Условия договора"), text: tr("Сумма вложений, порядок и сроки возврата инвестиций — наглядно, плюс скан договора со всеми приложениями.") },
  { icon: 'camera', title: tr("Онлайн-камера 24/7"), text: tr("Наблюдайте за ходом строительства в реальном времени — из любой точки мира.") },
  { icon: 'calendar', title: tr("Ежемесячный фотоотчёт"), text: tr("Фото со стройплощадки каждый месяц: что сделано и что запланировано дальше.") },
  { icon: 'chart', title: tr("Прайс-листы и продажи"), text: tr("Актуальные цены и динамика продаж с условиями сделок — скидки, рассрочки, графики платежей. Без персональных данных покупателей.") },
  { icon: 'shield', title: tr("Разрешительная документация"), text: tr("Все разрешения и документы по проекту — в одном месте.") },
  { icon: 'coins', title: tr("Расходы на строительство"), text: tr("В отдельных проектах — бухгалтерия по затратам со сканами счетов, квитанций и платёжных документов.") },
];
const faq = [
  { q: tr("Когда появляется доступ в кабинет инвестора?"), a: tr("Сразу после подписания инвестиционного договора: технические специалисты выдают персональный логин и пароль.") },
  { q: tr("Что именно будет видно в кабинете?"), a: tr("Набор функций зависит от пакета и прописывается в договоре. Как минимум — условия и скан договора; для строящихся проектов — камера, фотоотчёты, прайс-листы и продажи.") },
  { q: tr("Можно ли проверить расходы застройщика?"), a: tr("Да, в отдельных инвестиционных предложениях компания публикует полную бухгалтерию по затратам на строительство — с копиями всех платёжных документов.") },
];
---
<Base title={tr("Контроль инвестиций — кабинет инвестора Stay Investment")} description={tr("Прозрачный контроль вложений в недвижимость Турции: кабинет инвестора с онлайн-камерой 24/7, ежемесячными фотоотчётами, прайс-листами, динамикой продаж и документами по проекту.")} crumbs={[{ label: tr("Инвесторам") }, { label: tr("Контроль инвестиций") }]}>
  <PageHead eyebrow={tr("Инвесторам")} title={tr("Контроль инвестиций в реальном времени")} lead={tr("После подписания инвестиционного договора вы получаете доступ в личный кабинет инвестора на stayinvestment.com. Там собрано всё, чтобы самостоятельно следить за проектом и возвратом вложений.")} />
  <section class="container-x pb-12">
    <div data-reveal><InvestorCabinetMock /></div>
  </section>
  <section class="container-x pb-16">
    <h2 class="h-section" data-reveal>{tr("Что видно в кабинете")}</h2>
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((f, i) => (
        <div class="card lift p-7" data-reveal style={`--i:${i % 3}`}>
          <span class="grid h-12 w-12 place-items-center rounded-2xl bg-sea-soft text-sea"><Icon name={f.icon} size={24} /></span>
          <h3 class="mt-5 text-lg font-extrabold">{f.title}</h3>
          <p class="mt-2 text-[15px] leading-relaxed text-ink-2">{f.text}</p>
        </div>
      ))}
    </div>
    <div class="on-dark mt-8 grid gap-6 rounded-[20px] bg-ink p-8 text-white md:grid-cols-[auto_1fr] md:items-center md:p-10" data-reveal>
      <Icon name="key" size={40} class="text-white" />
      <div>
        <p class="text-xl font-extrabold">{tr("Независимый контроль, а не только наши отчёты")}</p>
        <p class="mt-2 max-w-3xl text-[15px] leading-relaxed text-white/90">{tr("Цены, продажи и расходы видны в динамике — поэтому вы можете сами отслеживать, как идёт возврат инвестиций, и сверять это с условиями договора. Функции кабинета зависят от выбранного пакета и закрепляются в договоре.")}</p>
      </div>
    </div>
  </section>
  <Faq items={faq} />
  <LeadSection source="control" />
</Base>
