---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
Astro.response.status = 404;
---
<Base title="Страница не найдена" description="Такой страницы нет. Перейдите в каталог инвестиций или на главную Stay Investment." noindex>
  <section class="container-x grid min-h-[60vh] place-items-center py-20 text-center">
    <div>
      <p class="text-[96px] font-extrabold leading-none text-brand tabular">404</p>
      <h1 class="mt-4 text-3xl font-extrabold">Страница не найдена</h1>
      <p class="lead mx-auto mt-3 max-w-lg">Возможно, объект уже продан или страница переехала. Загляните в каталог — там только актуальные предложения.</p>
      <div class="mt-8 flex flex-wrap justify-center gap-3">
        <a href="/investment-directory/" class="btn btn-primary">Каталог инвестиций <Icon name="arrow" size={18} /></a>
        <a href="/" class="btn btn-ghost">На главную</a>
      </div>
    </div>
  </section>
</Base>
