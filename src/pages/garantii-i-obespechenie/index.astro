---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import Faq from '../../components/Faq.astro';
import LeadSection from '../../components/LeadSection.astro';
import { langOf, useT } from '../../i18n';

const lang = langOf(Astro.locals);
const tr = useT(lang);
const notary = [
  tr("проверяет законность документов;"),
  tr("разъясняет сторонам юридические последствия договора;"),
  tr("проверяет дееспособность сторон и их действительные намерения;"),
  tr("проверяет, нет ли арестов и обременений на недвижимость;"),
  tr("удостоверяет, что стороны подписывают договор добровольно."),
];
const tools = [
  { icon: 'doc', short: tr("Вексель"), title: tr("Гарантийный вексель (senet)"), text: tr("Безусловное письменное обязательство Stay Investment выплатить инвестору сумму, равную вложениям и гарантированной прибыли. Это ценная бумага: её можно предъявить к взысканию после наступления срока.") },
  { icon: 'building', short: tr("Ипотека"), title: tr("Ипотека (ipotek)"), text: tr("Компания может оформить обременение в пользу инвестора на квартиры в строящемся проекте — в количестве, эквивалентном сумме инвестиций.") },
  { icon: 'key', short: tr("ТАПУ"), title: tr("ТАПУ на объекты"), text: tr("В рамках договора компания может выдать ТАПУ — свидетельство о праве собственности — на квартиры в проекте на сумму, эквивалентную вложениям.") },
];
const faq = [
  { q: tr("Обязательно ли заверять договор у нотариуса?"), a: tr("Нет, это опция. Но нотариальное заверение даёт больше правовой защиты, а дубликат договора всегда можно получить у нотариуса.") },
  { q: tr("Какое обеспечение выбрать?"), a: tr("Зависит от пакета и суммы. Вексель удобен для небольших сумм, ипотека и ТАПУ — для крупных вложений в партнёрские проекты. Консультант поможет подобрать вариант.") },
];
---
<Base title={tr("Гарантии и обеспечение инвестиций — нотариус, вексель, ипотека, ТАПУ")} description={tr("Как Stay Investment защищает вложения в недвижимость Турции: нотариальное заверение договора, гарантийный вексель (senet), ипотека (ipotek) и ТАПУ на объекты в проекте.")} crumbs={[{ label: tr("Инвесторам") }, { label: tr("Гарантии и обеспечение") }]}>
  <PageHead eyebrow={tr("Инвесторам")} title={tr("Гарантии и обеспечение инвестиций")} lead={tr("Любые инвестиции связаны с рисками. Надёжный девелопер с собственными проектами — хорошая основа для портфеля, а юридические инструменты защищают ваши вложения и их возврат.")} />
  <section class="container-x pb-12">
    <figure class="card p-6 md:p-9" aria-label={tr("Схема защиты вложений: инвестор, договор у нотариуса, обеспечение на выбор")}>
      <figcaption class="text-xl font-extrabold" data-reveal>{tr("Как защищены ваши вложения")}</figcaption>
      <ol class="mt-8 grid items-stretch gap-4 lg:grid-cols-[1fr_auto_1fr_auto_1.6fr]">
        <li class="rounded-[14px] bg-page p-5" data-reveal style="--i:0">
          <span class="grid h-11 w-11 place-items-center rounded-full bg-brand-2 text-[15px] font-bold text-white">1</span>
          <p class="mt-4 font-bold">{tr("Вы — инвестор")}</p>
          <p class="mt-1 text-[14px] leading-snug text-ink-2">{tr("Выбираете пакет и сумму, получаете проект договора")}</p>
        </li>
        <li class="grid place-items-center text-brand" aria-hidden="true" data-reveal style="--i:1"><Icon name="arrow" size={26} class="rotate-90 lg:rotate-0" /></li>
        <li class="rounded-[14px] bg-page p-5" data-reveal style="--i:2">
          <span class="grid h-11 w-11 place-items-center rounded-full bg-brand-2 text-[15px] font-bold text-white">2</span>
          <p class="mt-4 font-bold">{tr("Договор у нотариуса")}</p>
          <p class="mt-1 text-[14px] leading-snug text-ink-2">{tr("Нотариус проверяет документы, стороны и обременения")}</p>
        </li>
        <li class="grid place-items-center text-brand" aria-hidden="true" data-reveal style="--i:3"><Icon name="arrow" size={26} class="rotate-90 lg:rotate-0" /></li>
        <li class="rounded-[14px] border-2 border-dashed border-brand/40 p-5" data-reveal style="--i:4">
          <span class="grid h-11 w-11 place-items-center rounded-full bg-accent-2 text-[15px] font-bold text-white">3</span>
          <p class="mt-4 font-bold">{tr("Обеспечение на выбор")}</p>
          <div class="mt-3 grid gap-2 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3">
            {tools.map((t) => <span class="flex items-center gap-2 rounded-[10px] bg-sea-soft px-3 py-2 text-[13px] font-semibold text-brand-2"><Icon name={t.icon} size={16} />{t.short}</span>)}
          </div>
        </li>
      </ol>
    </figure>
  </section>

  <section class="container-x pb-16">
    <div class="grid gap-8 lg:grid-cols-[1.1fr_1fr]">
      <div class="card p-7 md:p-9" data-reveal>
        <span class="grid h-12 w-12 place-items-center rounded-2xl bg-sea-soft text-brand-2"><Icon name="shield" size={24} /></span>
        <h2 class="mt-5 text-2xl">{tr("Нотариальное заверение договора")}</h2>
        <p class="mt-3 text-[16px] leading-relaxed text-ink-2">{tr("Всем клиентам мы предлагаем заверить инвестиционный договор у турецкого нотариуса — это даёт сторонам дополнительную правовую защиту. Лицензированный нотариус:")}</p>
        <ul class="mt-4 grid gap-2.5">
          {notary.map((n) => <li class="flex gap-3 text-[15px]"><Icon name="check" size={18} class="mt-0.5 shrink-0 text-sea" stroke={2.2} />{n}</li>)}
        </ul>
        <p class="mt-5 text-[15px] leading-relaxed text-ink-2">{tr("Если кто-то из сторон потеряет свой экземпляр, нотариус выдаст дубликат с той же юридической силой.")}</p>
      </div>
      <div class="grid gap-5">
        {tools.map((t, i) => (
          <div class="card lift p-7" data-reveal style={`--i:${i + 1}`}>
            <div class="flex items-center gap-4">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-sea-soft text-sea"><Icon name={t.icon} size={22} /></span>
              <h3 class="text-lg font-extrabold">{t.title}</h3>
            </div>
            <p class="mt-3 text-[15px] leading-relaxed text-ink-2">{t.text}</p>
          </div>
        ))}
      </div>
    </div>
    <p class="mt-8 max-w-3xl text-[13.5px] leading-relaxed text-muted">{tr("Конкретный набор гарантий зависит от пакета и суммы инвестиций и фиксируется в инвестиционном договоре.")}</p>
  </section>
  <Faq items={faq} />
  <LeadSection source="guarantees" title={tr("Нужна консультация по гарантиям?")} text={tr("Покажем образец договора и расскажем, какое обеспечение подойдёт для вашей суммы и пакета.")} />
</Base>
