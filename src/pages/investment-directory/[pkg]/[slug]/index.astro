---
import Base from '../../../../layouts/Base.astro';
import Icon from '../../../../components/Icon.astro';
import ObjectCard from '../../../../components/ObjectCard.astro';
import Calculator from '../../../../components/Calculator.astro';
import LeadForm from '../../../../components/LeadForm.astro';
import Gallery from '../../../../components/Gallery.astro';
import PaymentPlan from '../../../../components/PaymentPlan.astro';
import PositionStrip from '../../../../components/PositionStrip.astro';
import { PACKAGES, packageInfo, localizeObject, findObject, byPackage, objectUrl, entryPrice, yieldOf, placeOf, metricLabel, formatMetric, euro } from '../../../../lib/catalog';
import { SITE } from '../../../../lib/site';
import { langOf, useT, LANG_META, fmtPct } from '../../../../i18n';

const lang = langOf(Astro.locals);
const tr = useT(lang);
const { pkg, slug } = Astro.params;
const found = findObject(pkg!, slug!);
if (!found) return Astro.rewrite('/404/');
const o = localizeObject(found, lang);

const info = packageInfo(o.package, lang);
const place = placeOf(found, lang);
const price = entryPrice(o);
const y = yieldOf(o, lang);
const similar = byPackage(o.package).filter((x) => x.id !== o.id).sort((a, b) => Math.abs((entryPrice(a) ?? 0) - (price ?? 0)) - Math.abs((entryPrice(b) ?? 0) - (price ?? 0))).slice(0, 3);
const facts = [
  place.city && { icon: 'pin', label: tr("Расположение"), value: [place.city, place.district].filter(Boolean).join(', ') },
  o.seaDistance && { icon: 'wave', label: tr("До моря"), value: o.seaDistance >= 1000 ? tr("{toLocaleString} км", { toLocaleString: (o.seaDistance / 1000).toLocaleString(LANG_META[lang].locale) }) : tr("{seaDistance} м", { seaDistance: o.seaDistance }) },
  o.type && { icon: 'building', label: tr("Тип"), value: o.type.replace('Садовый дуплекс', 'Садовый\u00a0дуплекс').replace(/ +/g, ', ') },
  o.layouts.length && { icon: 'layers', label: tr("Планировки"), value: o.layouts.join(', ') },
  o.year && { icon: 'calendar', label: tr("Сдача"), value: `${o.year}` },
].filter(Boolean) as { icon: string; label: string; value: string }[];

const plain = o.descriptionHtml.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const description = `${info.name}, ID ${o.id}: ${o.title}. ${price ? tr(o.package === 'partnerskye' ? 'Вход от {sum}' : 'Цена от {sum}', { sum: euro(price) }) : ''}${y ? `, ${y.label.toLowerCase()} ${fmtPct(lang, y.value)}` : ''}. ${plain}`.slice(0, 160).replace(/\s+\S*$/, '') + '…';
const ld = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateListing',
  name: o.title,
  url: `${SITE.url}${objectUrl(o)}`,
  image: o.images.slice(0, 5),
  description: plain.slice(0, 500),
  identifier: o.id,
  ...(price ? { offers: { '@type': 'Offer', price, priceCurrency: 'EUR', availability: 'https://schema.org/InStock' } } : {}),
  ...(place.city ? { contentLocation: { '@type': 'Place', name: [place.district, place.city, tr("Турция")].filter(Boolean).join(', ') } } : {}),
};
---
<Base
  title={`${o.title} — ${info.name}, ID ${o.id}`}
  {description}
  image={o.images[0]}
  crumbs={[{ label: tr("Каталог инвестиций"), href: '/investment-directory/' }, { label: info.name, href: `/investment-directory/${o.package}/` }, { label: o.id }]}
  jsonLd={[ld]}
>
  <section class="container-x pt-6 md:pt-10">
    <div class="hero-in flex flex-wrap items-center gap-2" style="--i:0">
      <a href={`/investment-directory/${o.package}/`} class="chip bg-sea-soft text-brand-2">{tr("Пакет «{name}»", { name: info.name })}</a>
      <span class="chip bg-surface text-muted tabular">ID {o.id}</span>
    </div>
    <h1 class="hero-in mt-4 max-w-4xl text-[30px] leading-[1.1] sm:text-[40px] lg:text-[48px]">{o.title}</h1>

    <div class="mt-8 grid gap-8 lg:grid-cols-[1.6fr_1fr]">
      <!-- Галерея -->
      <div class="hero-in min-w-0" style="--i:1"><Gallery images={o.images} title={o.title} /></div>

      <!-- Условия -->
      <aside class="hero-in lg:sticky lg:top-36 lg:self-start" style="--i:2">
        <div class="card p-6">
          <p class="text-[13px] font-semibold text-muted">{o.package === 'partnerskye' ? tr("Сумма входа") : o.package === 'startovye' ? tr("Стоимость лота, от") : tr("Стоимость, от")}</p>
          <p class="mt-1 text-[34px] font-extrabold leading-none tabular">{price != null ? <><span data-count={price}>{price.toLocaleString('ru-RU')}</span> €</> : '—'}</p>
          {y && <p class="mt-2 inline-flex items-center gap-1.5 font-bold text-sea"><Icon name="chart" size={18} />{y.label}: {fmtPct(lang, y.value)}</p>}
          <dl class="mt-5 grid grid-cols-2 gap-x-4 gap-y-4 border-t border-line pt-5">
            {o.metrics.filter((m) => !/Начальная стоимость|Минимальная стоимость лота|Сумма входа/.test(m.label)).map((m) => (
              <div>
                <dt class="text-[12.5px] leading-tight text-muted">{metricLabel(m.label, lang)}</dt>
                <dd class="mt-1 text-[17px] font-extrabold tabular">{m.value != null && Number.isInteger(m.value) ? <>{formatMetric(m, lang).split(m.value.toLocaleString('ru-RU'))[0]}<span data-count={m.value}>{m.value.toLocaleString('ru-RU')}</span>{formatMetric(m, lang).split(m.value.toLocaleString('ru-RU')).slice(1).join(m.value.toLocaleString('ru-RU'))}</> : formatMetric(m, lang)}</dd>
              </div>
            ))}
          </dl>
          <div class="mt-6 grid gap-2">
            <button type="button" class="btn btn-accent" data-lead-open data-lead-title={tr("Заявка по объекту {id}", { id: o.id })} data-lead-object={o.id} data-lead-source="object-buy" data-main-cta>{tr("Оставить заявку")}<Icon name="arrow" size={18} /></button>
            <div class="grid grid-cols-2 gap-2">
              <button type="button" class="btn btn-ghost btn-sm" data-lead-open data-lead-title={tr("Онлайн-показ объекта")} data-lead-object={o.id} data-lead-source="object-online"><Icon name="camera" size={16} />{tr("Онлайн-показ")}</button>
              <button type="button" class="btn btn-ghost btn-sm" data-lead-open data-lead-title={tr("Инфо-тур в Аланью")} data-lead-object={o.id} data-lead-source="object-tour"><Icon name="globe" size={16} />{tr("Инфо-тур")}</button>
            </div>
            <a href={`${SITE.whatsapp}?text=${encodeURIComponent(tr('Здравствуйте! Интересует объект {id}: {title}', { id: o.id, title: o.title }))}`} target="_blank" rel="noopener" class="btn btn-ghost btn-sm"><Icon name="whatsapp" size={16} />{tr("Спросить в WhatsApp")}</a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="container-x py-12 md:py-16">
    <div class="grid gap-10 lg:grid-cols-[1.6fr_1fr]">
      <div class="min-w-0">
        {facts.length > 0 && (
          <dl class="card grid overflow-hidden sm:grid-cols-2 lg:grid-cols-3">
            {facts.map((f) => (
              <div class="-mb-px -mr-px grid grid-cols-[22px_1fr] gap-x-3 border-b border-r border-line p-5">
                <dt class="contents"><Icon name={f.icon} size={22} class="row-span-2 mt-0.5 text-brand" /><span class="text-[13px] text-muted">{f.label}</span></dt>
                <dd class="col-start-2 font-bold">{f.value}</dd>
              </div>
            ))}
          </dl>
        )}
        <div class="mt-8 grid gap-6"><div data-reveal><PaymentPlan o={o} /></div><div data-reveal><PositionStrip o={o} /></div></div>
        <h2 class="mt-12 text-2xl">{tr("Об объекте")}</h2>
        <div class="prose-si mt-4" data-reveal set:html={o.descriptionHtml} />
        {o.infrastructure.length > 0 && (
          <>
            <h2 class="mt-12 text-2xl">{tr("Инфраструктура комплекса")}</h2>
            <ul class="mt-5 grid gap-x-6 gap-y-3 sm:grid-cols-2">
              {o.infrastructure.map((i) => <li class="flex items-center gap-3 text-[15px]"><span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-sea-soft text-sea"><Icon name="check" size={15} stroke={2.2} /></span>{i}</li>)}
            </ul>
          </>
        )}
        {o.video && (
          <div class="mt-12 aspect-video overflow-hidden rounded-[20px]">
            <iframe src={`https://www.youtube-nocookie.com/embed/${o.video}`} title={tr("Видео: {title}", { title: o.title })} loading="lazy" allowfullscreen class="h-full w-full"></iframe>
          </div>
        )}
      </div>
      <div class="grid min-w-0 content-start gap-6">
        <div data-reveal><Calculator o={o} /></div>
        <div class="card p-6">
          <p class="text-lg font-extrabold">{tr("Получить презентацию объекта")}</p>
          <p class="mt-1 text-[14px] text-ink-2">{tr("Планировки, прайс, график платежей и расчёт доходности — пришлём в мессенджер.")}</p>
          <div class="mt-4"><LeadForm source="object-presentation" object={o.id} compact button={tr("Получить презентацию")} /></div>
        </div>
      </div>
    </div>
  </section>

  {similar.length > 0 && (
    <section class="bg-sand/60 py-14 md:py-20">
      <div class="container-x">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 class="h-section">{tr("Похожие предложения")}</h2>
          <a href={`/investment-directory/${o.package}/`} class="btn btn-ghost">{tr("Все объекты пакета")} <Icon name="arrow" size={18} /></a>
        </div>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{similar.map((s, i) => <ObjectCard o={s} reveal={i} />)}</div>
      </div>
    </section>
  )}
  <!-- Телефон: панель заявки, когда основная кнопка ушла за экран -->
  <div class="cta-bar fixed inset-x-0 bottom-0 z-30 border-t border-line bg-surface/95 px-4 py-3 shadow-lift backdrop-blur lg:hidden" data-cta-bar aria-hidden="true">
    <div class="flex items-center gap-3">
      <div class="min-w-0">
        <p class="truncate text-[12px] text-muted">{info.name} · {o.id}</p>
        <p class="text-[17px] font-bold tabular">{euro(price)}</p>
      </div>
      <button type="button" class="btn btn-accent btn-sm ml-auto" tabindex="-1" data-lead-open data-lead-title={tr("Заявка по объекту {id}", { id: o.id })} data-lead-object={o.id} data-lead-source="object-bar">{tr("Оставить заявку")}</button>
    </div>
  </div>
</Base>
<script>
  const bar = document.querySelector<HTMLElement>('[data-cta-bar]');
  const cta = document.querySelector('[data-main-cta]');
  if (bar && cta) {
    new IntersectionObserver(([e]) => {
      const on = !e.isIntersecting && e.boundingClientRect.top < 0;
      bar.toggleAttribute('data-on', on);
      bar.setAttribute('aria-hidden', String(!on));
      bar.querySelector('button')!.tabIndex = on ? 0 : -1;
      document.body.classList.toggle('has-cta-bar', on);
    }).observe(cta);
  }
</script>
