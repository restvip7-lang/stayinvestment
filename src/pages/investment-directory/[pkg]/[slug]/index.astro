---
import Base from '../../../../layouts/Base.astro';
import Img from '../../../../components/Img.astro';
import Icon from '../../../../components/Icon.astro';
import ObjectCard from '../../../../components/ObjectCard.astro';
import Calculator from '../../../../components/Calculator.astro';
import LeadForm from '../../../../components/LeadForm.astro';
import PaymentPlan from '../../../../components/PaymentPlan.astro';
import PositionStrip from '../../../../components/PositionStrip.astro';
import { PACKAGES, findObject, byPackage, objectUrl, entryPrice, yieldOf, placeOf, metricLabel, formatMetric, euro } from '../../../../lib/catalog';
import { SITE } from '../../../../lib/site';

const { pkg, slug } = Astro.params;
const o = findObject(pkg!, slug!);
if (!o) return Astro.rewrite('/404/');

const info = PACKAGES[o.package];
const place = placeOf(o);
const price = entryPrice(o);
const y = yieldOf(o);
const similar = byPackage(o.package).filter((x) => x.id !== o.id).sort((a, b) => Math.abs((entryPrice(a) ?? 0) - (price ?? 0)) - Math.abs((entryPrice(b) ?? 0) - (price ?? 0))).slice(0, 3);
const facts = [
  place.city && { icon: 'pin', label: 'Расположение', value: [place.city, place.district].filter(Boolean).join(', ') },
  o.seaDistance && { icon: 'wave', label: 'До моря', value: o.seaDistance >= 1000 ? `${(o.seaDistance / 1000).toLocaleString('ru-RU')} км` : `${o.seaDistance} м` },
  o.type && { icon: 'building', label: 'Тип', value: o.type.replace(/\s+/g, ', ') },
  o.layouts.length && { icon: 'layers', label: 'Планировки', value: o.layouts.join(', ') },
  o.year && { icon: 'calendar', label: 'Сдача', value: `${o.year}` },
].filter(Boolean) as { icon: string; label: string; value: string }[];

const plain = o.descriptionHtml.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const description = `${info.name}, ID ${o.id}: ${o.title}. ${price ? `${o.package === 'partnerskye' ? 'Вход' : 'Цена'} от ${euro(price)}` : ''}${y ? `, ${y.label.toLowerCase()} ${y.value}%` : ''}. ${plain}`.slice(0, 160).replace(/\s+\S*$/, '') + '…';
const ld = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateListing',
  name: o.title,
  url: `${SITE.url}${objectUrl(o)}`,
  image: o.images.slice(0, 5),
  description: plain.slice(0, 500),
  identifier: o.id,
  ...(price ? { offers: { '@type': 'Offer', price, priceCurrency: 'EUR', availability: 'https://schema.org/InStock' } } : {}),
  ...(place.city ? { contentLocation: { '@type': 'Place', name: [place.district, place.city, 'Турция'].filter(Boolean).join(', ') } } : {}),
};
---
<Base
  title={`${o.title} — ${info.name}, ID ${o.id}`}
  {description}
  image={o.images[0]}
  crumbs={[{ label: 'Каталог инвестиций', href: '/investment-directory/' }, { label: info.name, href: `/investment-directory/${o.package}/` }, { label: o.id }]}
  jsonLd={[ld]}
>
  <section class="container-x pt-6 md:pt-10">
    <div class="flex flex-wrap items-center gap-2">
      <a href={`/investment-directory/${o.package}/`} class="chip bg-sea-soft text-brand-2">Пакет «{info.name}»</a>
      <span class="chip bg-surface text-muted tabular">ID {o.id}</span>
    </div>
    <h1 class="mt-4 max-w-4xl text-[30px] font-extrabold leading-[1.1] sm:text-[40px] lg:text-[48px]">{o.title}</h1>

    <div class="mt-8 grid gap-8 lg:grid-cols-[1.6fr_1fr]">
      <!-- Галерея -->
      <div class="min-w-0" data-gallery>
        <div class="relative overflow-hidden rounded-[20px]">
          <Img src={o.images[0]} alt={o.title} class="aspect-[16/10] w-full" width={1280} height={800} priority sizes="(min-width: 1024px) 60vw, 100vw" />
          {o.images.length > 1 && <span class="chip absolute bottom-4 right-4 bg-navy/80 text-white tabular" data-counter>1 / {o.images.length}</span>}
        </div>
        {o.images.length > 1 && (
          <div class="mt-3 flex gap-2 overflow-x-auto pb-1">
            {o.images.slice(0, 16).map((src, i) => (
              <button type="button" class:list={['h-16 w-24 shrink-0 overflow-hidden rounded-xl ring-2 ring-offset-2 ring-offset-page transition', i === 0 ? 'ring-brand' : 'ring-transparent hover:ring-line-2']} data-thumb={i} data-src={src} aria-label={`Фото ${i + 1}`}>
                <Img src={src} alt="" class="h-full w-full" width={192} height={128} sizes="96px" />
              </button>
            ))}
          </div>
        )}
      </div>

      <!-- Условия -->
      <aside class="lg:sticky lg:top-36 lg:self-start">
        <div class="card p-6">
          <p class="text-[13px] font-semibold text-muted">{o.package === 'partnerskye' ? 'Сумма входа' : o.package === 'startovye' ? 'Стоимость лота, от' : 'Стоимость, от'}</p>
          <p class="mt-1 text-[34px] font-extrabold leading-none tabular">{euro(price)}</p>
          {y && <p class="mt-2 inline-flex items-center gap-1.5 font-bold text-sea"><Icon name="chart" size={18} />{y.label}: {y.value}%</p>}
          <dl class="mt-5 grid grid-cols-2 gap-x-4 gap-y-4 border-t border-line pt-5">
            {o.metrics.filter((m) => !/Начальная стоимость|Минимальная стоимость лота|Сумма входа/.test(m.label)).map((m) => (
              <div>
                <dt class="text-[12.5px] leading-tight text-muted">{metricLabel(m.label)}</dt>
                <dd class="mt-1 text-[17px] font-extrabold tabular">{formatMetric(m)}</dd>
              </div>
            ))}
          </dl>
          <div class="mt-6 grid gap-2">
            <button type="button" class="btn btn-accent" data-lead-open data-lead-title={`Заявка по объекту ${o.id}`} data-lead-object={o.id} data-lead-source="object-buy">Оставить заявку</button>
            <div class="grid grid-cols-2 gap-2">
              <button type="button" class="btn btn-ghost btn-sm" data-lead-open data-lead-title="Онлайн-показ объекта" data-lead-object={o.id} data-lead-source="object-online"><Icon name="camera" size={16} />Онлайн-показ</button>
              <button type="button" class="btn btn-ghost btn-sm" data-lead-open data-lead-title="Инфо-тур в Аланью" data-lead-object={o.id} data-lead-source="object-tour"><Icon name="globe" size={16} />Инфо-тур</button>
            </div>
            <a href={`${SITE.whatsapp}?text=${encodeURIComponent(`Здравствуйте! Интересует объект ${o.id}: ${o.title}`)}`} target="_blank" rel="noopener" class="btn btn-ghost btn-sm"><Icon name="whatsapp" size={16} />Спросить в WhatsApp</a>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <section class="container-x py-12 md:py-16">
    <div class="grid gap-10 lg:grid-cols-[1.6fr_1fr]">
      <div class="min-w-0">
        {facts.length > 0 && (
          <dl class="card grid overflow-hidden sm:grid-cols-2 lg:grid-cols-3">
            {facts.map((f) => (
              <div class="-mb-px -mr-px flex gap-3 border-b border-r border-line p-5">
                <Icon name={f.icon} size={22} class="mt-0.5 shrink-0 text-brand" />
                <div><dt class="text-[13px] text-muted">{f.label}</dt><dd class="font-bold">{f.value}</dd></div>
              </div>
            ))}
          </dl>
        )}
        <div class="mt-8 grid gap-6"><PaymentPlan o={o} /><PositionStrip o={o} /></div>
        <h2 class="mt-12 text-2xl font-extrabold">Об объекте</h2>
        <div class="prose-si mt-4" set:html={o.descriptionHtml} />
        {o.infrastructure.length > 0 && (
          <>
            <h2 class="mt-12 text-2xl font-extrabold">Инфраструктура комплекса</h2>
            <ul class="mt-5 grid gap-x-6 gap-y-3 sm:grid-cols-2">
              {o.infrastructure.map((i) => <li class="flex items-center gap-3 text-[15px]"><span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-sea-soft text-sea"><Icon name="check" size={15} stroke={2.2} /></span>{i}</li>)}
            </ul>
          </>
        )}
        {o.video && (
          <div class="mt-12 aspect-video overflow-hidden rounded-[20px]">
            <iframe src={`https://www.youtube-nocookie.com/embed/${o.video}`} title={`Видео: ${o.title}`} loading="lazy" allowfullscreen class="h-full w-full"></iframe>
          </div>
        )}
      </div>
      <div class="grid min-w-0 content-start gap-6">
        <Calculator o={o} />
        <div class="card p-6">
          <p class="text-lg font-extrabold">Получить презентацию объекта</p>
          <p class="mt-1 text-[14px] text-ink-2">Планировки, прайс, график платежей и расчёт доходности — пришлём в мессенджер.</p>
          <div class="mt-4"><LeadForm source="object-presentation" object={o.id} compact button="Получить презентацию" /></div>
        </div>
      </div>
    </div>
  </section>

  {similar.length > 0 && (
    <section class="bg-sand/60 py-14 md:py-20">
      <div class="container-x">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <h2 class="h-section">Похожие предложения</h2>
          <a href={`/investment-directory/${o.package}/`} class="btn btn-ghost">Все объекты пакета <Icon name="arrow" size={18} /></a>
        </div>
        <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{similar.map((s) => <ObjectCard o={s} />)}</div>
      </div>
    </section>
  )}
</Base>
<script>
  for (const g of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const main = g.querySelector<HTMLImageElement>('img')!;
    const counter = g.querySelector('[data-counter]');
    const thumbs = [...g.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
    const total = counter?.textContent?.split('/')[1]?.trim();
    thumbs.forEach((t) => t.addEventListener('click', () => {
      const src = t.querySelector('img')?.currentSrc || t.dataset.src!;
      main.removeAttribute('srcset');
      main.src = t.querySelector('img')?.getAttribute('src')?.startsWith('/_vercel') ? `/_vercel/image?url=${encodeURIComponent(t.dataset.src!)}&w=1280&q=75` : src;
      thumbs.forEach((x) => x.classList.replace('ring-brand', 'ring-transparent'));
      t.classList.replace('ring-transparent', 'ring-brand');
      if (counter) counter.textContent = `${Number(t.dataset.thumb) + 1} / ${total}`;
    }));
  }
</script>
