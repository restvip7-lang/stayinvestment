---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import Catalog from '../../../components/Catalog.astro';
import LeadSection from '../../../components/LeadSection.astro';
import Faq from '../../../components/Faq.astro';
import Icon from '../../../components/Icon.astro';
import { PACKAGES, PACKAGE_ORDER, byPackage, objectUrl, type PackageKey } from '../../../lib/catalog';
import { PACKAGE_PAGES, BUSINESS_PAGE } from '../../../content/package-texts';

const { pkg } = Astro.params;
const isBusiness = pkg === 'biznes-investitsii';
if (!isBusiness && !PACKAGE_ORDER.includes(pkg as PackageKey)) return Astro.rewrite('/404/');

const key = pkg as PackageKey;
const info = isBusiness ? null : PACKAGES[key];
const page = isBusiness ? BUSINESS_PAGE : PACKAGE_PAGES[key];
const objects = isBusiness ? [] : byPackage(key);
const others = PACKAGE_ORDER.filter((k) => k !== key);
const title = isBusiness ? 'Инвестиции в бизнес в Турции — коммерческая недвижимость и отели' : info!.seoTitle;
const description = isBusiness
  ? 'Инвестиции в коммерческую недвижимость и бизнес в Турции: офисы, магазины, отели, земля под застройку. Подбор объекта, проверка документов и сопровождение сделки.'
  : info!.seoDescription;
const ld = objects.length
  ? [{ '@context': 'https://schema.org', '@type': 'ItemList', name: page.h1, itemListElement: objects.map((o, i) => ({ '@type': 'ListItem', position: i + 1, url: `https://stayinvestment.com${objectUrl(o)}`, name: o.title })) }]
  : [];
---
<Base {title} {description} crumbs={[{ label: 'Каталог инвестиций', href: '/investment-directory/' }, { label: isBusiness ? 'Инвестиции в бизнес' : info!.name }]} jsonLd={ld}>
  <PageHead eyebrow={isBusiness ? 'Инвестиции в бизнес' : `Пакет «${info!.name}»`} title={page.h1} lead={page.lead}>
    {isBusiness && <button type="button" class="btn btn-primary mt-8" data-lead-open data-lead-title="Подбор бизнес-проекта" data-lead-source="business">Получить подборку проектов</button>}
  </PageHead>

  {objects.length > 0 && (
    <section class="container-x pb-6">
      <Catalog objects={objects} current={key} />
    </section>
  )}

  <section class="container-x py-14 md:py-20">
    <div class="grid gap-12 lg:grid-cols-[2fr_1fr]">
      <article class="prose-si max-w-3xl" set:html={page.html} />
      <aside class="lg:sticky lg:top-36 lg:self-start">
        <div class="card p-6">
          <p class="text-[13px] font-bold uppercase tracking-[.14em] text-muted">Другие пакеты</p>
          <div class="mt-3 grid gap-1">
            {(isBusiness ? PACKAGE_ORDER : others).map((k) => (
              <a href={`/investment-directory/${k}/`} class="group flex items-center justify-between gap-3 rounded-xl px-3 py-3 hover:bg-page">
                <span><span class="block font-bold">«{PACKAGES[k].name}»</span><span class="text-[13px] text-muted">{PACKAGES[k].tagline}</span></span>
                <Icon name="arrow" size={16} class="shrink-0" />
              </a>
            ))}
            {!isBusiness && (
              <a href="/investment-directory/biznes-investitsii/" class="group flex items-center justify-between gap-3 rounded-xl px-3 py-3 hover:bg-page">
                <span><span class="block font-bold">«Инвестиции в бизнес»</span><span class="text-[13px] text-muted">Офисы, магазины, отели</span></span>
                <Icon name="arrow" size={16} class="shrink-0" />
              </a>
            )}
          </div>
        </div>
      </aside>
    </div>
  </section>

  {page.faq && <Faq items={page.faq} />}
  <LeadSection source={`package-${pkg}`} />
</Base>
