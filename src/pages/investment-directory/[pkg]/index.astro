---
import Base from '../../../layouts/Base.astro';
import PageHead from '../../../components/PageHead.astro';
import Catalog from '../../../components/Catalog.astro';
import LeadSection from '../../../components/LeadSection.astro';
import Faq from '../../../components/Faq.astro';
import Icon from '../../../components/Icon.astro';
import { PACKAGES, PACKAGE_ORDER, packageInfo, byPackage, objectUrl, packageFacts, packagePhoto, type PackageKey } from '../../../lib/catalog';
import { sectionText } from '../../../content/package-texts';
import { langOf, useT } from '../../../i18n';

const lang = langOf(Astro.locals);
const tr = useT(lang);
const { pkg } = Astro.params;
const isBusiness = pkg === 'biznes-investitsii';
if (!isBusiness && !PACKAGE_ORDER.includes(pkg as PackageKey)) return Astro.rewrite('/404/');

const key = pkg as PackageKey;
const info = isBusiness ? null : packageInfo(key, lang);
const page = sectionText(lang, isBusiness ? 'business' : key);
const objects = isBusiness ? [] : byPackage(key);
const others = PACKAGE_ORDER.filter((k) => k !== key);
const title = isBusiness ? tr("Инвестиции в бизнес в Турции — коммерческая недвижимость и отели") : info!.seoTitle;
const description = isBusiness
  ? tr("Инвестиции в коммерческую недвижимость и бизнес в Турции: офисы, магазины, отели, земля под застройку. Подбор объекта, проверка документов и сопровождение сделки.")
  : info!.seoDescription;
const ld = objects.length
  ? [{ '@context': 'https://schema.org', '@type': 'ItemList', name: page.h1, itemListElement: objects.map((o, i) => ({ '@type': 'ListItem', position: i + 1, url: `https://stayinvestment.com${objectUrl(o)}`, name: o.title })) }]
  : [];
---
<Base {title} {description} crumbs={[{ label: tr("Каталог инвестиций"), href: '/investment-directory/' }, { label: isBusiness ? tr("Инвестиции в бизнес") : info!.name }]} jsonLd={ld}>
  <PageHead
    eyebrow={isBusiness ? tr("Инвестиции в бизнес") : tr("Пакет «{name}»", { name: info!.name })}
    title={page.h1}
    lead={page.lead}
    image={isBusiness ? '/images/site/about-hero.jpg' : packagePhoto(key)}
    imageAlt={isBusiness ? tr("Коммерческая недвижимость в Аланье") : tr("Объект пакета «{name}»", { name: info!.name })}
    imageNote={isBusiness ? tr("Офисы, магазины, отели и земля под застройку") : tr("{length} объектов в Аланье и Стамбуле", { length: objects.length })}
  >
    {isBusiness
      ? <button type="button" class="btn btn-primary mt-8" data-lead-open data-lead-title={tr("Подбор бизнес-проекта")} data-lead-source="business">{tr("Получить подборку проектов")}<Icon name="arrow" size={18} /></button>
      : (
        <dl class="mt-8 grid max-w-xl grid-cols-1 gap-3 sm:grid-cols-3">
          {packageFacts(key, lang).map((f) => (
            <div class="card flex items-center gap-3 p-4 sm:block">
              <dt class="flex items-center gap-3 text-[13px] text-muted sm:block"><span class="grid h-9 w-9 shrink-0 place-items-center rounded-[10px] bg-sea-soft text-brand-2 sm:mb-3"><Icon name={f.icon} size={18} /></span>{f.label}</dt>
              <dd class="ml-auto text-[16px] font-bold tabular sm:ml-0 sm:mt-0.5">{f.value}</dd>
            </div>
          ))}
        </dl>
      )}
  </PageHead>

  {objects.length > 0 && (
    <section class="container-x pb-6">
      <Catalog objects={objects} current={key} />
    </section>
  )}

  <section class="container-x py-14 md:py-20">
    <div class="grid gap-12 lg:grid-cols-[2fr_1fr]">
      <article class="prose-si max-w-3xl" data-reveal set:html={page.html} />
      <aside class="lg:sticky lg:top-36 lg:self-start">
        <div class="card p-6" data-reveal style="--i:1">
          <p class="text-[13px] font-bold uppercase tracking-[.14em] text-muted">{tr("Другие пакеты")}</p>
          <div class="mt-3 grid gap-1">
            {(isBusiness ? PACKAGE_ORDER : others).map((k) => (
              <a href={`/investment-directory/${k}/`} class="group flex items-center justify-between gap-3 rounded-xl px-3 py-3 hover:bg-page">
                <span><span class="block font-bold">«{tr(PACKAGES[k].name)}»</span><span class="text-[13px] text-muted">{tr(PACKAGES[k].tagline)}</span></span>
                <Icon name="arrow" size={16} class="shrink-0" />
              </a>
            ))}
            {!isBusiness && (
              <a href="/investment-directory/biznes-investitsii/" class="group flex items-center justify-between gap-3 rounded-xl px-3 py-3 hover:bg-page">
                <span><span class="block font-bold">{tr("«Инвестиции в бизнес»")}</span><span class="text-[13px] text-muted">{tr("Офисы, магазины, отели")}</span></span>
                <Icon name="arrow" size={16} class="shrink-0" />
              </a>
            )}
          </div>
        </div>
      </aside>
    </div>
  </section>

  {page.faq && <Faq items={page.faq} />}
  <LeadSection source={`package-${pkg}`} />
</Base>
