---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Catalog from '../../components/Catalog.astro';
import LeadSection from '../../components/LeadSection.astro';
import Icon from '../../components/Icon.astro';
import { OBJECTS, PACKAGES, PACKAGE_ORDER, byPackage, objectUrl, entryPrice } from '../../lib/catalog';

const ld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: 'Каталог инвестиций в недвижимость Турции',
  numberOfItems: OBJECTS.length,
  itemListElement: OBJECTS.map((o, i) => ({ '@type': 'ListItem', position: i + 1, url: `https://stayinvestment.com${objectUrl(o)}`, name: o.title })),
};
---
<Base
  title="Каталог инвестиций в недвижимость Турции"
  description={`${OBJECTS.length} инвестиционных объектов в Аланье и Стамбуле: аренда с гарантией дохода, новостройки ниже рынка, доли в проектах девелопера. Вход от ${Math.round(Math.min(...OBJECTS.map(entryPrice).filter((x): x is number => x != null)) / 1000)} тыс. €.`}
  crumbs={[{ label: 'Каталог инвестиций' }]}
  jsonLd={[ld]}
>
  <PageHead eyebrow="Каталог" title="Каталог инвестиций в недвижимость Турции" lead="Готовые инвестиционные решения в Аланье и Стамбуле — а для каждого клиента мы разрабатываем индивидуальную стратегию. Выберите пакет или отфильтруйте объекты по бюджету и городу.">
    <div class="mt-8 grid gap-3 sm:grid-cols-3">
      {PACKAGE_ORDER.map((k) => (
        <a href={`/investment-directory/${k}/`} class="group flex items-center justify-between gap-4 rounded-[18px] border border-line-2 bg-surface/60 px-5 py-4 hover:border-ink">
          <span><span class="block font-extrabold">«{PACKAGES[k].name}» · {byPackage(k).length}</span><span class="text-[13.5px] text-muted">{PACKAGES[k].tagline}</span></span>
          <Icon name="arrow" size={18} class="shrink-0 transition-transform group-hover:translate-x-1" />
        </a>
      ))}
    </div>
  </PageHead>
  <section class="container-x pb-8">
    <Catalog objects={OBJECTS} />
  </section>
  <LeadSection source="catalog" title="Не нашли подходящий объект?" text="Расскажите о бюджете и цели — подберём объекты вне каталога, в том числе коммерческую недвижимость и участки под застройку." />
</Base>
