---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Img from '../components/Img.astro';
import ObjectCard from '../components/ObjectCard.astro';
import NewsCard from '../components/NewsCard.astro';
import Faq from '../components/Faq.astro';
import PackageCompare from '../components/PackageCompare.astro';
import CashflowTimeline from '../components/CashflowTimeline.astro';
import LeadSection from '../components/LeadSection.astro';
import { OBJECTS, PACKAGES, localizeObject, PACKAGE_ORDER, byPackage, entryPrice, yieldOf, euro, objectUrl, packageFacts, packagePhoto } from '../lib/catalog';
import { getNews } from '../lib/news';
import { STATS, TEAM, yearsOnMarket } from '../lib/site';
import { langOf, useT } from '../i18n';

const lang = langOf(Astro.locals);
const tr = useT(lang);
const news = (await getNews(lang)).slice(0, 3);

// Цифры первого экрана — из каталога, чтобы не расходились с объектами.
const minEntry = Math.min(...OBJECTS.map(entryPrice).filter((x): x is number => x != null));
const maxRoi = Math.max(...byPackage('partnerskye').map((o) => yieldOf(o, lang)?.value ?? 0));
const rentYields = byPackage('rental').map((o) => yieldOf(o, lang)?.value ?? 0).filter(Boolean);
const minRent = Math.min(...rentYields);
const maxRent = Math.max(...rentYields);

const featured = PACKAGE_ORDER.flatMap((p) => byPackage(p).filter((o) => o.images.length >= 4).slice(0, 2));
const pkgPhoto = packagePhoto;
const pkgFacts = packageFacts;
const heroObjects = [byPackage('rental')[0], byPackage('partnerskye')[0], byPackage('startovye')[0]].filter(Boolean).map((o) => localizeObject(o, lang));

const whyTurkey = [
  { icon: 'chart', title: tr("Крупная экономика"), text: tr("Турция входит в двадцатку крупнейших экономик мира: ВВП — около $1,3 трлн по данным Всемирного банка.") },
  { icon: 'globe', title: tr("Мост между Европой и Азией"), text: tr("Страна контролирует Босфор и Дарданеллы, омывается четырьмя морями и служит транспортным хабом для трёх континентов.") },
  { icon: 'layers', title: tr("Доступ к большим рынкам"), text: tr("Таможенный союз с ЕС и соглашения о свободной торговле открывают выход на рынки с населением более 1 млрд человек.") },
  { icon: 'handshake', title: tr("Молодое население"), text: tr("Медианный возраст — около 33 лет: растущий спрос на жильё со стороны самих турок, а не только иностранцев.") },
  { icon: 'wave', title: tr("Туристический спрос"), text: tr("Анталья — главный курортный регион Турции: поток туристов поддерживает рынок краткосрочной аренды, а мягкая зима — спрос на долгосрочную.") },
  { icon: 'key', title: tr("ВНЖ и гражданство"), text: tr("Покупка недвижимости даёт основание для ВНЖ, а от $400 000 — право претендовать на гражданство Турции.") },
];

const advantages = [
  { icon: 'building', title: tr("Девелопер, а не посредник"), text: tr("Stay Property строит собственные проекты с 2018 года. До 90% квартир в наших комплексах продаются ещё на этапе строительства.") },
  { icon: 'coins', title: tr("Доходность по договору"), text: tr("Прогнозируемая доходность — до 30% и выше в зависимости от пакета и суммы. Условия выплат прописываются в инвестиционном договоре.") },
  { icon: 'eye', title: tr("Прозрачная отчётность"), text: tr("Кабинет инвестора: онлайн-камера на стройке, фотоотчёты, прайс-листы и динамика продаж в реальном времени.") },
  { icon: 'shield', title: tr("Юридическая защита"), text: tr("Нотариальное заверение договора, гарантийный вексель, ипотека или ТАПУ на объекты в качестве обеспечения.") },
  { icon: 'briefcase', title: tr("Низкий порог входа"), text: tr("Готовые решения от {euro} — с рассрочкой от застройщика и возможностью диверсифицировать портфель.", { euro: euro(minEntry) }) },
  { icon: 'globe', title: tr("Сервис под ключ"), text: tr("Подбор, сделка, управление арендой и перепродажа — силами одной группы компаний с офисами в 6 странах.") },
];

const steps = [
  { title: tr("Стратегия и подбор"), text: tr("Определяем цель — арендный доход, рост капитала или доля в проекте — и подбираем объекты под ваш бюджет и горизонт инвестирования.") },
  { title: tr("Договор и вход в проект"), text: tr("Подписываем инвестиционный договор, при желании — у нотариуса. Вы приобретаете объект или долю в праве собственности на имущество проекта.") },
  { title: tr("Контроль на каждом этапе"), text: tr("В кабинете инвестора видно ход строительства, рост стоимости и продажи квартир. Отчёты — ежемесячно, камера — круглосуточно.") },
  { title: tr("Выплата дохода"), text: tr("После завершения строительства раскрываются эскроу-счета, прибыль от продаж распределяется между участниками — и вы получаете свои средства.") },
];

const pkgIcon = { rental: 'key', startovye: 'chart', partnerskye: 'handshake' } as const;

const faq = [
  { q: tr("С какой суммы можно начать инвестировать в недвижимость Турции?"), a: tr("Минимальный вход в нашем каталоге сейчас — {euro}. Для многих объектов доступна беспроцентная рассрочка от застройщика с первым взносом от 10–30%. Доля в партнёрских проектах начинается от нескольких сотен тысяч евро.", { euro: euro(minEntry) }) },
  { q: tr("Какую доходность можно получить?"), a: tr("В пакете «Рантье» застройщик гарантирует арендный доход {minRent}–{maxRent}% годовых на 2–5 лет. В «Стартовом» доход формируется за счёт роста цены от котлована до сдачи дома. В «Партнерском» прогнозируемый ROI за цикл проекта — от 30% до {maxRoi}%. Все цифры фиксируются в договоре и не являются публичной офертой.", { minRent, maxRent, maxRoi }) },
  { q: tr("Как я смогу контролировать вложения из другой страны?"), a: tr("После подписания договора вы получаете доступ в личный кабинет инвестора: условия договора и его скан, онлайн-камера на стройке, ежемесячные фотоотчёты, обновляемые прайс-листы и динамика продаж. В отдельных проектах публикуется и бухгалтерия по расходам на строительство.") },
  { q: tr("Какие гарантии защищают инвестора?"), a: tr("Договор можно заверить у турецкого нотариуса. В качестве обеспечения компания выписывает гарантийный вексель (senet) на сумму вложений и прибыли, может оформить ипотеку (ipotek) или выдать ТАПУ на объекты в строящемся проекте.") },
  { q: tr("Можно ли получить ВНЖ или гражданство Турции?"), a: tr("Владение жильём в Турции даёт основание для получения ВНЖ. При покупке недвижимости от $400 000 с обязательством не продавать её 3 года можно претендовать на гражданство. Наши юристы сопровождают оба процесса.") },
  { q: tr("Нужно ли приезжать в Турцию для сделки?"), a: tr("Нет. Сделку можно провести дистанционно — по нотариальной доверенности, с онлайн-показом объекта и электронным документооборотом. При желании организуем инфо-тур в Аланью.") },
];
---
<Base
  title={tr("Инвестиции в недвижимость Турции — арендный доход, новостройки, доли в проектах")}
  description={tr("Stay Investment — инвестиции в недвижимость Аланьи и Стамбула от девелопера Stay Property: гарантия арендного дохода, квартиры на старте продаж ниже рынка, доли в проектах с ROI до {maxRoi}%. Вход от {euro}.", { maxRoi, euro: euro(minEntry) })}
>
  <!-- HERO -->
  <section class="relative overflow-hidden">
    <div class="pointer-events-none absolute inset-0 -z-10" aria-hidden="true">
      <div class="blob absolute -left-32 -top-40 h-[480px] w-[480px] rounded-full bg-brand/10 blur-3xl"></div>
      <div class="blob absolute -bottom-40 right-[-10%] h-[520px] w-[520px] rounded-full bg-accent/[.07] blur-3xl [animation-delay:-7s]"></div>
    </div>
    <div class="container-x grid grid-cols-1 gap-12 pb-16 pt-10 md:pt-16 lg:grid-cols-[1.05fr_1fr] lg:items-center lg:pb-24">
      <div class="min-w-0">
        <p class="eyebrow hero-in" style="--i:0">{tr("Девелопер Stay Property · {yearsOnMarket} лет на рынке Турции", { yearsOnMarket: yearsOnMarket() })}</p>
        <h1 class="hero-in mt-5 text-[clamp(26px,8vw,40px)] leading-[1.08] sm:text-[48px] lg:text-[40px] xl:text-[52px]" style="--i:1">{tr("Инвестиции в недвижимость Турции")}</h1>
        <p class="lead hero-in mt-6 max-w-xl" style="--i:2">{tr("Арендный доход с гарантией застройщика, покупка на старте продаж ниже рынка и доли в собственных проектах девелопера — в Аланье и Стамбуле, с контролем вложений онлайн.")}</p>
        <div class="hero-in mt-8 flex flex-wrap gap-3" style="--i:3">
          <a href="/investment-directory/" class="btn btn-primary">{tr("Смотреть объекты")} <Icon name="arrow" size={18} /></a>
          <button type="button" class="btn btn-ghost" data-lead-open data-lead-title={tr("Подобрать стратегию")} data-lead-source="hero">{tr("Подобрать стратегию")}</button>
        </div>
        <a href={objectUrl(heroObjects[0])} class="hero-in img-outline relative mt-8 block overflow-hidden rounded-[20px] lg:hidden" style="--i:4" aria-label={heroObjects[0].title}>
          <Img src={heroObjects[0].images[0]} alt={heroObjects[0].title} class="aspect-[16/10] w-full" width={960} height={600} priority sizes="100vw" />
          <span class="absolute inset-x-3 bottom-3 flex items-center justify-between gap-3 rounded-[12px] bg-white/95 px-4 py-2.5 shadow-card">
            <span class="min-w-0 truncate text-[13px] font-semibold">«{tr(PACKAGES[heroObjects[0].package].name)}» · {heroObjects[0].id}</span>
            <span class="shrink-0 text-[14px] font-bold text-sea tabular">{yieldOf(heroObjects[0], lang) ? tr("{value}% в год", { value: yieldOf(heroObjects[0], lang)!.value }) : euro(entryPrice(heroObjects[0]))}</span>
          </span>
        </a>
        <dl class="hero-in mt-10 grid max-w-xl grid-cols-3 gap-4 border-t border-line pt-6" style="--i:5">
          <div><dt class="text-[13px] text-muted">{tr("Вход")}</dt><dd class="mt-1 whitespace-nowrap text-[17px] font-extrabold tabular sm:text-2xl">{tr("от {round} тыс. €", { round: Math.round(minEntry / 1000) })}</dd></div>
          <div><dt class="text-[13px] text-muted">{tr("Арендный доход")}</dt><dd class="mt-1 whitespace-nowrap text-[17px] font-extrabold tabular sm:text-2xl">{minRent}–{maxRent}%<span class="text-base font-bold text-muted"> / {tr("год")}</span></dd></div>
          <div><dt class="text-[13px] text-muted">{tr("ROI в проектах")}</dt><dd class="mt-1 whitespace-nowrap text-[17px] font-extrabold tabular text-sea sm:text-2xl">{tr("до {maxRoi}%", { maxRoi })}</dd></div>
        </dl>
      </div>
      <div class="relative hidden h-[560px] lg:block" aria-hidden="true">
        {heroObjects.map((o, i) => (
          <a href={objectUrl(o)} tabindex="-1" class:list={[
            'card hero-in lift img-outline absolute block overflow-hidden',
            i === 0 && 'left-0 top-6 w-[62%] rotate-[-2deg]',
            i === 1 && 'right-0 top-0 w-[52%] rotate-[3deg]',
            i === 2 && 'bottom-0 left-[22%] w-[58%] rotate-[1deg]',
          ]} style={`--i:${i + 2}`}>
            <Img src={o.images[0]} alt="" class="aspect-[4/3] w-full" width={640} height={480} priority={i === 0} sizes="400px" />
            <div class="flex items-center justify-between gap-3 px-4 py-3">
              <span class="truncate text-[13px] font-bold">{tr(PACKAGES[o.package].name)} · {o.id}</span>
              <span class="shrink-0 text-[13px] font-extrabold text-sea tabular">{yieldOf(o, lang) ? `${yieldOf(o, lang)!.value}%` : euro(entryPrice(o))}</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="border-y border-line bg-surface">
    <div class="container-x grid grid-cols-2 gap-y-8 py-10 md:grid-cols-4 md:py-12">
      {STATS.map((s, i) => (
        <div class="border-l-2 border-brand pl-5" data-reveal style={`--i:${i}`}>
          <p class="whitespace-nowrap text-[26px] font-extrabold tabular sm:text-3xl md:text-[40px]"><span data-count={s.value}>{s.value.toLocaleString('ru-RU')}</span>{tr(s.suffix)}</p>
          <p class="mt-1 text-[14px] text-ink-2">{tr(s.label)}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- PACKAGES -->
  <section class="container-x py-16 md:py-24">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">{tr("Инвестиционные пакеты")}</p>
        <h2 class="h-section mt-3">{tr("Четыре стратегии — под разные цели и бюджеты")}</h2>
        <p class="lead mt-4">{tr("В портфеле — объекты с гарантированным арендным доходом, новостройки на старте продаж, проекты с доходностью на партнёрских условиях и коммерческая недвижимость. Можно выбрать один пакет или собрать диверсифицированный портфель.")}</p>
      </div>
      <a href="/investment-directory/" class="btn btn-ghost">{tr("Весь каталог")} <Icon name="arrow" size={18} /></a>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
      <!-- Каждая карточка — подсетка из 4 строк (фото, заголовок, цифры, ссылка): строки выровнены во всём ряду -->
      {PACKAGE_ORDER.map((k) => {
        const items = byPackage(k);
        return (
          <a href={`/investment-directory/${k}/`} class="card lift group row-span-4 grid grid-rows-subgrid gap-y-0 overflow-hidden" data-reveal style={`--i:${PACKAGE_ORDER.indexOf(k)}`}>
            <div class="img-outline relative aspect-[16/9] overflow-hidden">
              <Img src={pkgPhoto(k)} alt={tr("Пакет «{name}»", { name: tr(PACKAGES[k].name) })} class="h-full w-full transition-transform duration-700 [transition-timing-function:var(--ease-out-quart)] group-hover:scale-[1.04]" width={640} height={360} sizes="(min-width: 768px) 33vw, 100vw" />
              <span class="absolute left-4 top-4 grid h-11 w-11 place-items-center rounded-[12px] bg-white/95 text-brand-2 shadow-card"><Icon name={pkgIcon[k]} size={22} /></span>
              <span class="chip absolute right-4 top-4 bg-white/95 text-ink">{tr("{length} объектов", { length: items.length })}</span>
            </div>
            <div class="px-6 pt-6">
              <h3 class="text-2xl font-extrabold">«{tr(PACKAGES[k].name)}»</h3>
              <p class="mt-1 font-semibold text-sea">{tr(PACKAGES[k].tagline)}</p>
            </div>
              <dl class="mx-6 mb-6 mt-5 grid content-start gap-3">
                {pkgFacts(k, lang).map((f) => (
                  <div class="flex items-center gap-3">
                    <dt class="flex items-center gap-3 text-[14px] text-ink-2"><span class="grid h-9 w-9 shrink-0 place-items-center rounded-[10px] bg-sea-soft text-brand-2"><Icon name={f.icon} size={18} /></span>{f.label}</dt>
                    <dd class="ml-auto text-[15px] font-bold tabular">{f.value}</dd>
                  </div>
                ))}
              </dl>
              <span class="mx-6 mb-6 inline-flex items-center gap-2 self-end border-t border-line pt-5 font-semibold text-brand-2">{tr("Смотреть объекты пакета")} <Icon name="arrow" size={18} class="transition-transform group-hover:translate-x-1" /></span>
          </a>
        );
      })}
      <a href="/investment-directory/biznes-investitsii/" class="card lift group row-span-4 grid grid-rows-subgrid gap-y-0 overflow-hidden" data-reveal style="--i:3">
        <div class="img-outline relative aspect-[16/9] overflow-hidden">
          <Img src="/images/site/about-hero.jpg" alt={tr("Пакет «Инвестиции в бизнес»")} class="h-full w-full transition-transform duration-700 [transition-timing-function:var(--ease-out-quart)] group-hover:scale-[1.04]" width={640} height={360} sizes="(min-width: 1280px) 25vw, (min-width: 640px) 50vw, 100vw" />
          <span class="absolute left-4 top-4 grid h-11 w-11 place-items-center rounded-[12px] bg-white/95 text-brand-2 shadow-card"><Icon name="briefcase" size={22} /></span>
          <span class="chip absolute right-4 top-4 bg-white/95 text-ink">{tr("Подбор под запрос")}</span>
        </div>
        <div class="px-6 pt-6">
          <h3 class="text-2xl font-extrabold">{tr("«Инвестиции в бизнес»")}</h3>
          <p class="mt-1 font-semibold text-sea">{tr("Офисы, магазины, отели и земля")}</p>
        </div>
          <dl class="mx-6 mb-6 mt-5 grid content-start gap-3">
            {[
              { icon: 'building', label: tr("Объекты"), value: tr("Коммерческие") },
              { icon: 'chart', label: tr("Доходность"), value: tr("Расчёт под объект") },
              { icon: 'coins', label: tr("Вход"), value: tr("По запросу") },
            ].map((f) => (
              <div class="flex items-center gap-3">
                <dt class="flex items-center gap-3 text-[14px] text-ink-2"><span class="grid h-9 w-9 shrink-0 place-items-center rounded-[10px] bg-sea-soft text-brand-2"><Icon name={f.icon} size={18} /></span>{f.label}</dt>
                <dd class="ml-auto text-right text-[15px] font-bold leading-[1.2]">{f.value}</dd>
              </div>
            ))}
          </dl>
          <span class="mx-6 mb-6 inline-flex items-center gap-2 self-end border-t border-line pt-5 font-semibold text-brand-2">{tr("Подробнее о пакете")} <Icon name="arrow" size={18} class="transition-transform group-hover:translate-x-1" /></span>
      </a>
    </div>

  </section>

  <!-- COMPARE -->
  <section class="container-x pb-16 md:pb-24">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">{tr("Сравнение")}</p>
        <h2 class="h-section mt-3">{tr("Пакеты в цифрах")}</h2>
        <p class="lead mt-4">{tr("Вход, доходность, горизонт и ликвидность — по объектам из каталога. Помогает выбрать стратегию или собрать портфель из нескольких.")}</p>
      </div>
      <a href="/metodika-i-riski/" class="btn btn-ghost">{tr("Методика и риски")} <Icon name="arrow" size={18} /></a>
    </div>
    <div class="mt-10 grid gap-6">
      <div data-reveal><PackageCompare /></div>
      <div data-reveal><CashflowTimeline /></div>
    </div>
  </section>

  <!-- FEATURED -->
  <section class="bg-sand/60 py-16 md:py-24">
    <div class="container-x">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div class="max-w-2xl" data-reveal>
          <p class="eyebrow">{tr("Каталог")}</p>
          <h2 class="h-section mt-3">{tr("Актуальные инвестиционные предложения")}</h2>
          <p class="lead mt-4">{tr("Готовые решения в Аланье и Стамбуле — а для каждого клиента разрабатываем индивидуальную стратегию.")}</p>
        </div>
        <a href="/investment-directory/" class="btn btn-primary">{tr("Все {length} объектов", { length: OBJECTS.length })} <Icon name="arrow" size={18} /></a>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {featured.map((o, i) => <div class="grid" data-reveal style={`--i:${i % 3}`}><ObjectCard o={o} /></div>)}
      </div>
    </div>
  </section>

  <!-- ADVANTAGES -->
  <section class="container-x py-16 md:py-24">
    <div class="max-w-2xl">
      <p class="eyebrow">{tr("Почему Stay Investment")}</p>
      <h2 class="h-section mt-3">{tr("Инвестируете вместе с застройщиком")}</h2>
    </div>
    <div class="mt-10 grid gap-px overflow-hidden rounded-[20px] bg-line sm:grid-cols-2 lg:grid-cols-3">
      {advantages.map((a, i) => (
        <div class="bg-surface p-7" data-reveal style={`--i:${i % 3}`}>
          <Icon name={a.icon} size={26} class="text-brand" />
          <h3 class="mt-5 text-lg font-extrabold">{a.title}</h3>
          <p class="mt-2 text-[15px] leading-relaxed text-ink-2">{a.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- STEPS -->
  <section class="bg-sand py-16 md:py-24">
    <div class="container-x">
      <div class="max-w-2xl" data-reveal>
        <p class="eyebrow">{tr("Как это работает")}</p>
        <h2 class="h-section mt-3">{tr("Четыре шага к доходу")}</h2>
      </div>
      <ol class="mt-12 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
        {steps.map((s, i) => (
          <li class="card relative p-6" data-reveal style={`--i:${i}`}>
            <span class="grid h-10 w-10 place-items-center rounded-full bg-accent-soft text-[15px] font-bold tabular text-accent-2">{i + 1}</span>
            <h3 class="mt-3 text-xl font-extrabold">{s.title}</h3>
            <p class="mt-3 text-[15px] leading-relaxed text-ink-2">{s.text}</p>
          </li>
        ))}
      </ol>
      <div class="mt-12 grid gap-4 md:grid-cols-2">
        <a href="/garantii-i-obespechenie/" class="group flex items-center justify-between gap-6 card p-6 transition-shadow hover:shadow-lift">
          <span class="flex items-center gap-4"><Icon name="shield" size={28} class="text-brand" /><span><span class="block text-lg font-extrabold">{tr("Гарантии и обеспечение")}</span><span class="text-[14px] text-ink-2">{tr("Нотариус, вексель, ипотека, ТАПУ")}</span></span></span>
          <Icon name="arrow" class="transition-transform group-hover:translate-x-1" />
        </a>
        <a href="/kontrol-investitsij/" class="group flex items-center justify-between gap-6 card p-6 transition-shadow hover:shadow-lift">
          <span class="flex items-center gap-4"><Icon name="eye" size={28} class="text-brand" /><span><span class="block text-lg font-extrabold">{tr("Контроль инвестиций")}</span><span class="text-[14px] text-ink-2">{tr("Кабинет инвестора и отчётность")}</span></span></span>
          <Icon name="arrow" class="transition-transform group-hover:translate-x-1" />
        </a>
      </div>
    </div>
  </section>

  <!-- WHY TURKEY -->
  <section class="container-x py-16 md:py-24">
    <div class="grid gap-10 lg:grid-cols-[1fr_2fr]">
      <div>
        <p class="eyebrow">{tr("Рынок")}</p>
        <h2 class="h-section mt-3">{tr("Почему недвижимость Турции")}</h2>
        <p class="lead mt-4">{tr("Турецкая недвижимость — ликвидный и востребованный актив: квартиры в современных комплексах и виллы на побережье покупают инвесторы из десятков стран — ради арендного дохода, роста капитала и ВНЖ.")}</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        {whyTurkey.map((w, i) => (
          <div class="flex gap-4" data-reveal style={`--i:${i % 2}`}>
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-sea-soft text-sea"><Icon name={w.icon} size={22} /></span>
            <div>
              <h3 class="font-extrabold">{w.title}</h3>
              <p class="mt-1.5 text-[15px] leading-relaxed text-ink-2">{w.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COMPANY + TEAM -->
  <section class="bg-sand/60 py-16 md:py-24">
    <div class="container-x grid gap-12 lg:grid-cols-2 lg:items-center">
      <div class="relative">
        <Img src="/images/site/about-riverside.jpg" alt={tr("Жилой комплекс Exodus Riverside от Stay Property: бассейн и зона отдыха (визуализация)")} class="aspect-[4/3] w-full rounded-[20px]" width={660} height={495} sizes="(min-width: 1024px) 50vw, 100vw" />
        <div class="card absolute -bottom-6 right-4 max-w-[260px] p-5 sm:right-8">
          <p class="text-3xl font-extrabold text-sea">{tr("до 90%")}</p>
          <p class="mt-1 text-[14px] text-ink-2">{tr("квартир в наших комплексах продаётся ещё на этапе строительства")}</p>
        </div>
      </div>
      <div>
        <p class="eyebrow">{tr("О компании")}</p>
        <h2 class="h-section mt-3">{tr("Инвестиционное направление группы Stay Property")}</h2>
        <p class="lead mt-4">{tr("Stay Property начинала в 2018 году с небольшого жилого комплекса в Авсалларе, а сегодня — один из самых динамичных девелоперов региона с офисами в Турции, Казахстане, ОАЭ и на Северном Кипре.")}</p>
        <p class="mt-4 text-[16px] leading-relaxed text-ink-2">{tr("Stay Investment открывает инвесторам доступ к проектам группы — на тех же условиях, на которых их развиваем мы сами.")}</p>
        <a href="/o-kompanii/" class="btn btn-ghost mt-8">{tr("Подробнее о компании")} <Icon name="arrow" size={18} /></a>
      </div>
    </div>
    <div class="container-x mt-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h3 class="text-2xl font-extrabold md:text-3xl">{tr("Команда, которая ведёт ваши инвестиции")}</h3>
        <p class="max-w-md text-[15px] text-ink-2">{tr("Многолетний опыт на рынке Турции и знание всех юридических тонкостей — ответим на любой вопрос.")}</p>
      </div>
      <div class="mt-8 grid gap-5 sm:grid-cols-3">
        {TEAM.map((t, i) => (
          <div class="card lift overflow-hidden" data-reveal style={`--i:${i}`}>
            <div class="img-outline relative overflow-hidden"><Img src={t.photo} alt={tr(t.name)} class={`aspect-[4/5] w-full ${t.focus}`} width={600} height={750} sizes="(min-width: 640px) 33vw, 100vw" /></div>
            <div class="flex items-center justify-between gap-3 p-5">
              <div>
                <p class="font-extrabold">{tr(t.name)}</p>
                <p class="text-[14px] text-muted">{tr(t.role)}</p>
              </div>
              <a href={t.whatsapp} target="_blank" rel="noopener" class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-[#25d366]/10 text-[#1a9e4b] hover:bg-[#25d366]/20" aria-label={tr("Написать {name} в WhatsApp", { name: tr(t.name) })}><Icon name="whatsapp" size={20} /></a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- NEWS -->
  {news.length > 0 && (
    <section class="container-x py-16 md:py-24">
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow">{tr("Новости")}</p>
          <h2 class="h-section mt-3">{tr("Рынок недвижимости Турции")}</h2>
        </div>
        <a href="/news/" class="btn btn-ghost">{tr("Все новости")} <Icon name="arrow" size={18} /></a>
      </div>
      <div class="mt-10 grid gap-8 md:grid-cols-3">
        {news.map((n, i) => <div data-reveal style={`--i:${i}`}><NewsCard n={n} /></div>)}
      </div>
    </section>
  )}

  <Faq items={faq} />
  <LeadSection source="home" />
</Base>
