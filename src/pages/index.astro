  <!-- WHY TURKEY -->
  <section class="container-x py-16 md:py-24">
    <div class="grid gap-10 lg:grid-cols-[1fr_2fr]">
      <div>
        <p class="eyebrow">Рынок</p>
        <h2 class="h-section mt-3">Почему недвижимость Турции</h2>
        <p class="lead mt-4">Турецкая недвижимость — ликвидный и востребованный актив: квартиры в современных комплексах и виллы на побережье покупают инвесторы из десятков стран — ради арендного дохода, роста капитала и ВНЖ.</p>
      </div>
      <div class="grid gap-5 sm:grid-cols-2">
        {whyTurkey.map((w, i) => (
          <div class="flex gap-4" data-reveal style={`--i:${i % 2}`}>
            <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-sea-soft text-sea"><Icon name={w.icon} size={22} /></span>
            <div>
              <h3 class="font-extrabold">{w.title}</h3>
              <p class="mt-1.5 text-[15px] leading-relaxed text-ink-2">{w.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- COMPANY + TEAM -->
  <section class="bg-sand/60 py-16 md:py-24">
    <div class="container-x grid gap-12 lg:grid-cols-2 lg:items-center">
      <div class="relative">
        <Img src="/images/site/about-riverside.jpg" alt="Жилой комплекс Exodus Riverside от Stay Property: бассейн и зона отдыха (визуализация)" class="aspect-[4/3] w-full rounded-[20px]" width={660} height={495} sizes="(min-width: 1024px) 50vw, 100vw" />
        <div class="card absolute -bottom-6 right-4 max-w-[260px] p-5 sm:right-8">
          <p class="text-3xl font-extrabold text-sea">до 90%</p>
          <p class="mt-1 text-[14px] text-ink-2">квартир в наших комплексах продаётся ещё на этапе строительства</p>
        </div>
      </div>
      <div>
        <p class="eyebrow">О компании</p>
        <h2 class="h-section mt-3">Инвестиционное направление группы Stay Property</h2>
        <p class="lead mt-4">Stay Property начинала в 2018 году с небольшого жилого комплекса в Авсалларе, а сегодня — один из самых динамичных девелоперов региона с офисами в Турции, Казахстане, ОАЭ и на Северном Кипре.</p>
        <p class="mt-4 text-[16px] leading-relaxed text-ink-2">Stay Investment открывает инвесторам доступ к проектам группы — на тех же условиях, на которых их развиваем мы сами.</p>
        <a href="/o-kompanii/" class="btn btn-ghost mt-8">Подробнее о компании <Icon name="arrow" size={18} /></a>
      </div>
    </div>
    <div class="container-x mt-20">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <h3 class="text-2xl font-extrabold md:text-3xl">Команда, которая ведёт ваши инвестиции</h3>
        <p class="max-w-md text-[15px] text-ink-2">Многолетний опыт на рынке Турции и знание всех юридических тонкостей — ответим на любой вопрос.</p>
      </div>
      <div class="mt-8 grid gap-5 sm:grid-cols-3">
        {TEAM.map((t, i) => (
          <div class="card lift overflow-hidden" data-reveal style={`--i:${i}`}>
            <div class="img-outline relative overflow-hidden"><Img src={t.photo} alt={t.name} class={`aspect-[4/5] w-full ${t.focus}`} width={600} height={750} sizes="(min-width: 640px) 33vw, 100vw" /></div>
            <div class="flex items-center justify-between gap-3 p-5">
              <div>
                <p class="font-extrabold">{t.name}</p>
                <p class="text-[14px] text-muted">{t.role}</p>
              </div>
              <a href={t.whatsapp} target="_blank" rel="noopener" class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-[#25d366]/10 text-[#1a9e4b] hover:bg-[#25d366]/20" aria-label={`Написать ${t.name} в WhatsApp`}><Icon name="whatsapp" size={20} /></a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- NEWS -->
