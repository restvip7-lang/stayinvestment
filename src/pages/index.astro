        </div>
        <a href="/news/" class="btn btn-ghost">Все новости <Icon name="arrow" size={18} /></a>
      </div>
      <div class="mt-10 grid gap-8 md:grid-cols-3">
        {news.map((n, i) => <div data-reveal style={`--i:${i}`}><NewsCard n={n} /></div>)}
      </div>
