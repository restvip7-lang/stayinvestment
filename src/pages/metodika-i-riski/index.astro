---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import CashflowTimeline from '../../components/CashflowTimeline.astro';
import LeadSection from '../../components/LeadSection.astro';
import { langOf, useT } from '../../i18n';

const lang = langOf(Astro.locals);
const tr = useT(lang);
const nav = [
  { id: 'metodika', label: tr("Как мы считаем доходность") },
  { id: 'cashflow', label: tr("Движение денег по пакетам") },
  { id: 'raskhody', label: tr("Что не входит в доходность") },
  { id: 'riski', label: tr("Риски и как мы их снижаем") },
  { id: 'glossary', label: tr("Глоссарий") },
];

const formulas = [
  {
    pkg: tr("«Рантье»"),
    name: tr("Арендная доходность"),
    formula: tr("Гарантированный арендный доход за год ÷ Стоимость объекта × 100%"),
    example: tr("Квартира за 110 000 €, гарантированный доход 5 500 € в год → 5% годовых. За 2 года гарантии — 11 000 €, или 10% от вложений."),
  },
  {
    pkg: tr("«Стартовый»"),
    name: tr("Доход от перепродажи"),
    formula: tr("(Цена продажи − Цена покупки) ÷ Цена покупки × 100%"),
    example: tr("Лот за 110 000 € на старте строительства, продажа после сдачи дома за 127 000 € → +15,5%. Ориентир по рынку — 15–20% за цикл."),
  },
  {
    pkg: tr("«Партнерский»"),
    name: tr("ROI за цикл проекта"),
    formula: tr("Прибыль инвестора ÷ Сумма входа × 100%"),
    example: tr("Вход 1 225 000 €, прибыль по итогам продаж 563 500 € → ROI 46% за 30 месяцев."),
  },
];

const costs = [
  { title: tr("Налог на регистрацию права (ТАПУ)"), text: tr("Разовый, при покупке: 4% от стоимости, указанной в ТАПУ. Обычно распределяется между покупателем и продавцом по договорённости.") },
  { title: tr("Сделка"), text: tr("Переводчик и нотариус, оценка недвижимости (там, где она обязательна), открытие счёта, страховка от землетрясения (DASK).") },
  { title: tr("Содержание"), text: tr("Ежемесячный взнос на обслуживание комплекса (aidat) и ежегодный налог на имущество — от 0,1 до 0,6% кадастровой стоимости.") },
  { title: tr("Налоги на доход"), text: tr("Налог на доход от аренды в Турции, а при продаже раньше чем через 5 лет владения — налог на прирост стоимости. Учитывайте и налоги страны вашего резидентства.") },
];

const risks = [
  { icon: 'building', risk: tr("Строительный"), what: tr("Задержка сроков или изменение проекта."), how: tr("Работаем с проектами группы Stay Property и проверенными застройщиками. Сроки и ответственность — в договоре; ход стройки — онлайн-камера и ежемесячные фотоотчёты в кабинете инвестора.") },
  { icon: 'chart', risk: tr("Рыночный"), what: tr("Цены растут медленнее прогноза или снижаются."), how: tr("Отбираем локации с устойчивым спросом, показываем несколько сценариев выхода (продажа, аренда, удержание) и помогаем распределить вложения между пакетами.") },
  { icon: 'key', risk: tr("Арендный"), what: tr("Простой квартиры, нет арендаторов."), how: tr("В «Рантье» арендный доход на 2–5 лет гарантирует застройщик. После гарантии объект можно передать в управление Stay Property.") },
  { icon: 'coins', risk: tr("Валютный"), what: tr("Колебания курса турецкой лиры."), how: tr("Цены объектов и суммы по договорам указаны в евро. Валюту выплат дохода уточняйте в договоре до подписания.") },
  { icon: 'layers', risk: tr("Ликвидность"), what: tr("Нельзя быстро вернуть деньги."), how: tr("Ликвидность разная: готовую квартиру можно продать, долю в партнёрском проекте — только по итогам цикла. Мы показываем горизонт заранее — см. сравнение пакетов.") },
  { icon: 'doc', risk: tr("Юридический"), what: tr("Проблемы с правом собственности, разрешениями, изменения законов."), how: tr("Проверяем ТАПУ, разрешения на строительство и обременения (due diligence), договор можно заверить у нотариуса. Следим за изменениями законодательства — публикуем их в новостях.") },
  { icon: 'shield', risk: tr("Риск контрагента"), what: tr("Компания не исполняет обязательства."), how: tr("Обеспечение по договору: гарантийный вексель (senet), ипотека (ipotek) или ТАПУ на квартиры проекта на сумму вложений.") },
];

const glossary = [
  [tr("ТАПУ (tapu)"), tr("Свидетельство о праве собственности на недвижимость в Турции. Выдаётся Земельным кадастром (Tapu ve Kadastro).")],
  [tr("Искан (iskan)"), tr("Разрешение на ввод дома в эксплуатацию и заселение. После него оформляется ТАПУ на квартиру в новостройке.")],
  [tr("Сенет (senet)"), tr("Гарантийный вексель — безусловное письменное обязательство выплатить сумму к определённой дате.")],
  [tr("Ипотек (ipotek)"), tr("Обременение недвижимости в пользу кредитора или инвестора: объект нельзя продать, пока обязательство не исполнено.")],
  [tr("Эскроу-счёт"), tr("Банковский счёт, на котором деньги покупателей хранятся до выполнения условий сделки — например, до сдачи дома.")],
  [tr("Арендная доходность"), tr("Годовой арендный доход в процентах от стоимости объекта.")],
  ['ROI', tr("Return on Investment — отношение прибыли к вложенной сумме за весь срок инвестиции.")],
  [tr("Годовой эквивалент"), tr("Доходность за цикл, пересчитанная на один год по формуле сложного процента — чтобы сравнивать вложения разной длительности.")],
  [tr("Окупаемость"), tr("Срок, за который вложения возвращаются вместе с прибылью; в партнёрских проектах — длительность цикла.")],
  [tr("Рассрочка застройщика"), tr("Оплата квартиры частями без процентов до сдачи дома: первый взнос + платежи по графику.")],
  [tr("Переуступка"), tr("Продажа прав по договору на квартиру до сдачи дома, обычно — по согласованию с застройщиком.")],
  ['Due diligence', tr("Комплексная проверка объекта и продавца до сделки: документы, права, обременения, разрешения.")],
  [tr("Айдат (aidat)"), tr("Ежемесячный взнос на обслуживание жилого комплекса: охрана, уборка, бассейн, управление.")],
  ['DASK', tr("Обязательное страхование недвижимости от землетрясений в Турции.")],
];

const annRows = [[15, 24], [20, 24], [36, 30], [46, 30], [60, 30]] as const;
const annMax = 60;
const pct = (x: number) => x.toLocaleString('ru-RU', { maximumFractionDigits: 1 });
const ann = (roi: number, months: number) => (Math.pow(1 + roi / 100, 12 / months) - 1) * 100;
---
<Base
  title={tr("Методика расчёта доходности и риски инвестиций в недвижимость Турции")}
  description={tr("Как Stay Investment считает арендную доходность, доход от перепродажи и ROI; какие расходы и налоги не входят в доходность; какие риски есть у инвестиций в недвижимость Турции и как мы их снижаем.")}
  crumbs={[{ label: tr("Инвесторам") }, { label: tr("Методика и риски") }]}
>
  <PageHead eyebrow={tr("Инвесторам")} title={tr("Методика расчёта и риски")} lead={tr("Открыто показываем, как считаем доходность, что в неё не входит и какие риски есть у каждого пакета. Чтобы вы сравнивали предложения по одной логике — и с нашими, и с чужими.")}>
    <nav class="mt-8 flex flex-wrap gap-2" aria-label={tr("Разделы страницы")}>
      {nav.map((n) => <a href={`#${n.id}`} class="btn btn-ghost btn-sm">{n.label}</a>)}
    </nav>
  </PageHead>

  <section id="metodika" class="container-x scroll-mt-40 pb-16">
    <div data-reveal><h2 class="h-section">{tr("Как мы считаем доходность")}</h2>
    <p class="lead mt-4 max-w-3xl">{tr("У каждого пакета — своя модель дохода, поэтому и показатели разные. Все цифры на сайте — до налогов и расходов на содержание.")}</p></div>
    <div class="mt-8 grid gap-5 lg:grid-cols-3">
      {formulas.map((f, i) => (
        <article class="card lift flex flex-col p-7" data-reveal style={`--i:${i}`}>
          <p class="text-[13px] font-bold uppercase tracking-[.12em] text-accent-2">{f.pkg}</p>
          <h3 class="mt-2 text-xl font-extrabold">{f.name}</h3>
          <p class="mt-4 rounded-xl bg-page px-4 py-3 font-mono text-[13.5px] leading-relaxed text-ink">{f.formula}</p>
          <p class="mt-4 text-[14.5px] leading-relaxed text-ink-2"><span class="font-bold text-ink">{tr("Пример.")} </span>{f.example}</p>
        </article>
      ))}
    </div>
    <div class="card mt-5 grid gap-8 p-7 md:grid-cols-[1fr_1.2fr] md:items-center">
      <div data-reveal>
        <h3 class="text-xl font-extrabold">{tr("Годовой эквивалент: сравнение вложений разной длины")}</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-ink-2">{tr("ROI 46% за 30 месяцев и 5% годовых нельзя сравнивать напрямую. Мы пересчитываем доход за цикл в годовой по формуле сложного процента:")}</p>
        <p class="mt-3 rounded-xl bg-page px-4 py-3 font-mono text-[13.5px]">{tr("(1 + ROI) ^ (12 ÷ месяцев) − 1")}</p>
      </div>
      <figure data-reveal style="--i:1">
        <figcaption class="flex flex-wrap items-center gap-x-5 gap-y-1 text-[13px] text-ink-2">
          <span class="flex items-center gap-2"><span class="legend-key bg-[#a9cfe9]"></span>{tr("Доходность за цикл")}</span>
          <span class="flex items-center gap-2"><span class="legend-key bg-brand-2"></span>{tr("В пересчёте на год")}</span>
        </figcaption>
        <div class="mt-4 grid gap-4" aria-hidden="true">
          {annRows.map(([r, m]) => (
            <div class="grid grid-cols-[92px_1fr] items-center gap-3">
              <span class="text-[13px] font-semibold leading-tight text-ink">{r}%<span class="block font-normal text-muted">{tr("за {m} мес.", { m })}</span></span>
              <div class="grid gap-1.5">
                <div class="flex items-center gap-2"><span class="bar-grow h-3 rounded-r-[4px] bg-[#a9cfe9]" style={`width:${(r / annMax) * 82}%`} data-tip={tr("{r}%|за цикл {m} мес.", { r, m })}></span><span class="text-[12.5px] text-ink-2 tabular">{r}%</span></div>
                <div class="flex items-center gap-2"><span class="bar-grow h-3 rounded-r-[4px] bg-brand-2" style={`width:${(ann(r, m) / annMax) * 82}%;transition-delay:120ms`} data-tip={tr("≈ {pct}% в год|при {r}% за {m} мес.", { pct: pct(ann(r, m)), r, m })}></span><span class="text-[12.5px] font-bold text-ink tabular">≈ {pct(ann(r, m))}%</span></div>
              </div>
            </div>
          ))}
        </div>
        <div class="sr-only"><table>
          <caption>{tr("Примеры пересчёта доходности за цикл в годовую")}</caption>
          <thead><tr><th>{tr("Доходность за цикл")}</th><th>{tr("Срок")}</th><th>{tr("В год")}</th></tr></thead>
          <tbody>{annRows.map(([r, m]) => <tr><td>{r}%</td><td>{tr("{m} мес.", { m })}</td><td>≈ {pct(ann(r, m))}%</td></tr>)}</tbody>
        </table></div>
      </figure>
    </div>
  </section>

  <section id="cashflow" class="container-x scroll-mt-40 pb-16">
    <div data-reveal><CashflowTimeline /></div>
  </section>

  <section id="raskhody" class="scroll-mt-40 bg-sand/60 py-16 md:py-20">
    <div class="container-x">
      <h2 class="h-section" data-reveal>{tr("Что не входит в доходность")}</h2>
      <p class="lead mt-4 max-w-3xl">{tr("Чтобы оценить чистый результат, учтите расходы на сделку, содержание и налоги. Мы рассчитаем их под ваш объект и страну налогового резидентства.")}</p>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {costs.map((c, i) => (
          <div class="card lift p-6" data-reveal style={`--i:${i}`}>
            <h3 class="font-extrabold">{c.title}</h3>
            <p class="mt-2 text-[14.5px] leading-relaxed text-ink-2">{c.text}</p>
          </div>
        ))}
      </div>
      <p class="mt-5 text-[13px] text-muted">{tr("Ставки налогов и сборов приведены для ориентира и меняются; актуальные значения уточняйте у юриста или налогового консультанта.")}</p>
    </div>
  </section>

  <section id="riski" class="container-x scroll-mt-40 py-16 md:py-24">
    <h2 class="h-section" data-reveal>{tr("Риски и как мы их снижаем")}</h2>
    <p class="lead mt-4 max-w-3xl">{tr("Инвестиций без риска не бывает. Ниже — основные риски вложений в недвижимость Турции и то, что мы делаем, чтобы их снизить.")}</p>
    <div class="card mt-8 overflow-hidden">
      <table class="w-full text-left text-[15px]">
        <caption class="sr-only">{tr("Риски инвестиций и меры по их снижению")}</caption>
        <thead class="hidden border-b border-line text-[12.5px] uppercase tracking-[.12em] text-muted md:table-header-group">
          <tr><th class="w-[22%] px-6 py-4 font-bold">{tr("Риск")}</th><th class="w-[28%] px-6 py-4 font-bold">{tr("Что может произойти")}</th><th class="px-6 py-4 font-bold">{tr("Как снижаем")}</th></tr>
        </thead>
        <tbody>
          {risks.map((r, i) => (
            <tr class="block border-b border-line p-5 last:border-0 md:table-row md:p-0" data-reveal style={`--i:${i % 4}`}>
              <th scope="row" class="block font-extrabold md:table-cell md:px-6 md:py-5 md:align-top">
                <span class="flex items-center gap-3"><span class="grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-sea-soft text-sea"><Icon name={r.icon} size={18} /></span>{r.risk}</span>
              </th>
              <td class="mt-3 block text-ink-2 md:mt-0 md:table-cell md:px-6 md:py-5 md:align-top">{r.what}</td>
              <td class="mt-2 block leading-relaxed text-ink md:mt-0 md:table-cell md:px-6 md:py-5 md:align-top">{r.how}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section id="glossary" class="scroll-mt-40 bg-sand/60 py-16 md:py-24">
    <div class="container-x">
      <h2 class="h-section" data-reveal>{tr("Глоссарий")}</h2>
      <dl class="mt-8 grid gap-x-10 gap-y-6 md:grid-cols-2">
        {glossary.map(([t, d], i) => (
          <div class="border-t border-line-2 pt-4" data-reveal style={`--i:${i % 2}`}>
            <dt class="font-extrabold">{t}</dt>
            <dd class="mt-1 text-[15px] leading-relaxed text-ink-2">{d}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <LeadSection source="methodology" title={tr("Посчитаем доходность под ваш сценарий")} text={tr("Учтём налоги вашей страны, расходы на сделку и содержание, валюту выплат — и покажем чистую доходность по 2–3 подходящим объектам.")} />
</Base>
