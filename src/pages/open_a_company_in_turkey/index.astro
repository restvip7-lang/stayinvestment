---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import LeadForm from '../../components/LeadForm.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import Faq from '../../components/Faq.astro';
import LeadSection from '../../components/LeadSection.astro';
import html from '../../content/pages/open-company.html?raw';

const toc = [...html.matchAll(/<h2>(.*?)<\/h2>/g)].map((m, i) => ({ id: `s${i + 1}`, label: m[1].replace(/<[^>]+>/g, '') }));
let n = 0;
const body = html.replace(/<h2>/g, () => `<h2 id="s${++n}">`);
const faq = [
  { q: 'Может ли иностранец открыть компанию в Турции без турецкого партнёра?', a: 'Да. Закон № 4875 уравнивает права иностранных и турецких предпринимателей: ООО или АО можно открыть со 100% иностранным капиталом, директором тоже может быть иностранец.' },
  { q: 'Какой минимальный уставный капитал у ООО и АО?', a: 'С 2024 года — 50 000 TL для ООО (limited şirketi) и 250 000 TL для АО (anonim şirketi). Не менее 25% капитала вносится до завершения регистрации.' },
  { q: 'Нужно ли нанимать пятерых граждан Турции?', a: 'Это классическое условие для разрешения на работу иностранцу. С 1 октября 2024 года от него можно освободиться — например, при инвестициях в бизнес от $100 000.' },
];
---
<Base
  title="Как открыть компанию в Турции иностранцу — пошаговая инструкция"
  description="Как иностранцу открыть ООО или АО в Турции: ограничения, свободные экономические зоны, документы, регистрация в MERSİS, капитал и налоги, новые правила найма с 2024 года."
  type="article"
  crumbs={[{ label: 'Инвесторам', href: '/kontrol-investitsij/' }, { label: 'Как открыть компанию в Турции' }]}
>
  <PageHead eyebrow="Инвесторам" title="Как открыть компанию в Турции: пошаговая инструкция" lead="Формы компаний, документы, регистрация, налоги и новые правила найма — всё, что нужно знать иностранному предпринимателю." />
  <section class="container-x pb-10">
    <div class="grid gap-12 lg:grid-cols-[260px_1fr_300px]">
      <nav class="hidden lg:sticky lg:top-36 lg:block lg:self-start" aria-label="Содержание">
        <p class="text-[13px] font-bold uppercase tracking-[.14em] text-muted">Содержание</p>
        <ol class="mt-4 grid gap-1 border-l border-line pl-3 text-[14.5px]">
          {toc.map((t) => <li><a href={`#${t.id}`} class="-ml-3 block border-l-2 border-transparent py-1 pl-3 text-ink-2 transition-colors duration-200 hover:text-brand-2 aria-[current=true]:border-brand aria-[current=true]:font-semibold aria-[current=true]:text-brand-2" data-toc={t.id}>{t.label}</a></li>)}
        </ol>
      </nav>
      <article class="prose-si min-w-0 max-w-3xl" id="guide" set:html={body} />
      <aside class="lg:sticky lg:top-36 lg:self-start">
        <div class="card p-6">
          <p class="text-lg font-extrabold">Поможем открыть бизнес в Турции</p>
          <p class="mt-1 text-[14px] text-ink-2">Регистрация компании, бухгалтер, ВНЖ и разрешение на работу — под ключ.</p>
          <div class="mt-4"><LeadForm source="open-company" compact button="Получить консультацию" /></div>
        </div>
        <p class="mt-4 text-[12.5px] leading-snug text-muted">Материал носит справочный характер. Требования к капиталу, налоги и сборы меняются — уточняйте актуальные условия у юриста.</p>
      </aside>
    </div>
  </section>
  <Faq items={faq} />
  <LeadSection source="open-company" title="Открываете бизнес в Турции?" text="Подберём форму компании, подготовим документы и пройдём регистрацию вместе с вами. А если нужен офис, отель или помещение под бизнес — подберём и его." />
  <ReadingProgress target="#guide" />
</Base>
<script>
  // Подсветка текущего раздела в оглавлении
  const links = new Map([...document.querySelectorAll<HTMLAnchorElement>('[data-toc]')].map((a) => [a.dataset.toc!, a]));
  const set = (id: string) => links.forEach((a, k) => a.setAttribute('aria-current', String(k === id)));
  const io = new IntersectionObserver((entries) => {
    const vis = entries.filter((e) => e.isIntersecting).sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top)[0];
    if (vis) set(vis.target.id);
  }, { rootMargin: '-140px 0px -60% 0px' });
  document.querySelectorAll('#guide h2[id]').forEach((h) => io.observe(h));
</script>
