---
import Base from '../../layouts/Base.astro';
import PageHead from '../../components/PageHead.astro';
import Icon from '../../components/Icon.astro';
import LeadForm from '../../components/LeadForm.astro';
import { SITE, TEAM } from '../../lib/site';

const ld = {
  '@context': 'https://schema.org',
  '@type': 'RealEstateAgent',
  name: SITE.name,
  url: SITE.url,
  telephone: SITE.phone,
  address: { '@type': 'PostalAddress', streetAddress: 'Oba Mah., Mesut Cad., No: 54', postalCode: '07400', addressLocality: 'Alanya', addressRegion: 'Antalya', addressCountry: 'TR' },
};
---
<Base title="Контакты Stay Investment — офис в Аланье" description={`Контакты Stay Investment: ${SITE.phone}, WhatsApp, офис в Аланье — ${SITE.addressRu}. Консультации по инвестициям в недвижимость Турции онлайн и в офисе.`} crumbs={[{ label: 'Контакты' }]} jsonLd={[ld]}>
  <PageHead eyebrow="Контакты" title="Свяжитесь с нами" lead="Консультируем онлайн и в главном офисе в Аланье. Ответим на русском, английском и турецком." />
  <section class="container-x pb-16 md:pb-24">
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1fr_1.1fr]">
      <div class="grid min-w-0 grid-cols-1 content-start gap-5">
        <div class="card p-7" data-reveal>
          <p class="text-[13px] font-bold uppercase tracking-[.14em] text-muted">Главный офис</p>
          <p class="mt-3 text-xl font-extrabold">Аланья, Турция</p>
          <p class="mt-1 text-[15px] text-ink-2">{SITE.addressRu}<br /><span class="text-muted">{SITE.address}</span></p>
          <div class="mt-6 grid gap-3">
            <a href={SITE.phoneHref} class="flex items-center gap-3 text-lg font-extrabold tabular hover:text-brand-2"><span class="grid h-10 w-10 place-items-center rounded-full bg-sea-soft text-brand-2"><Icon name="phone" size={18} /></span>{SITE.phone}</a>
            <a href={SITE.whatsapp} target="_blank" rel="noopener" class="flex items-center gap-3 font-bold hover:text-brand-2"><span class="grid h-10 w-10 place-items-center rounded-full bg-[#25d366]/10 text-[#1a9e4b]"><Icon name="whatsapp" size={18} /></span>WhatsApp</a>
            <a href={SITE.instagram} target="_blank" rel="noopener" class="flex items-center gap-3 font-bold hover:text-brand-2"><span class="grid h-10 w-10 place-items-center rounded-full bg-sand text-ink"><Icon name="instagram" size={18} /></span>@stayinvestment</a>
          </div>
        </div>
        <div class="card p-7" data-reveal style="--i:1">
          <p class="text-[13px] font-bold uppercase tracking-[.14em] text-muted">Консультанты</p>
          <ul class="mt-4 divide-y divide-line">
            {TEAM.map((t) => (
              <li class="flex items-center justify-between gap-4 py-3">
                <span><span class="block font-bold">{t.name}</span><span class="text-[14px] text-muted">{t.role}</span></span>
                <a href={t.whatsapp} target="_blank" rel="noopener" class="btn btn-ghost btn-sm" aria-label={`WhatsApp — ${t.name}`}><Icon name="whatsapp" size={16} />Написать</a>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <div class="grid min-w-0 grid-cols-1 content-start gap-5">
        <div class="img-outline relative overflow-hidden rounded-[20px] bg-sand" data-reveal>
          <iframe title="Офис Stay Investment на карте" src="https://www.google.com/maps?q=Oba+Mah.+Mesut+Cad.+No:54+Alanya&output=embed" loading="lazy" class="aspect-[16/10] w-full border-0" referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
        <div class="card p-7" data-reveal style="--i:1">
          <p class="text-xl font-extrabold">Напишите нам</p>
          <p class="mt-1 text-[15px] text-ink-2">Оставьте контакты и вопрос — консультант перезвонит в течение рабочего дня.</p>
          <div class="mt-5"><LeadForm source="contacts" withComment button="Отправить" /></div>
        </div>
      </div>
    </div>
  </section>
</Base>
