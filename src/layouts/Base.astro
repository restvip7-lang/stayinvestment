---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LeadForm from '../components/LeadForm.astro';
import Icon from '../components/Icon.astro';
import VizTooltip from '../components/VizTooltip.astro';
import { SITE } from '../lib/site';
import { langOf, useT, LANGS, LANG_META, localePath } from '../i18n';
import { clientDict } from '../i18n/client';

interface Crumb { label: string; href?: string }
interface Props {
  title: string;
  description: string;
  image?: string | null;
  /** Хлебные крошки → schema.org BreadcrumbList */
  crumbs?: Crumb[];
  /** Доп. разметка schema.org */
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  type?: 'website' | 'article';
}
const lang = langOf(Astro.locals);
const tr = useT(lang);
const { title, description, image, crumbs = [], jsonLd = [], noindex = false, type = 'website' } = Astro.props;
const path = Astro.locals.path ?? Astro.url.pathname;
const canonical = new URL(localePath(lang, path), SITE.url).href;
// Версии страницы на других языках (для поисковиков и переключателя)
const alternates = LANGS.map((l) => ({ lang: l, href: new URL(localePath(l, path), SITE.url).href }));
const fullTitle = title.includes(SITE.name) ? title : `${title} — ${SITE.name}`;
const ogImage = image ? new URL(image, SITE.url).href : `${SITE.url}/images/site/og.jpg`;

const ld: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name,
    url: SITE.url,
    logo: `${SITE.url}/images/site/logo-old.png`,
    telephone: SITE.phone,
    address: { '@type': 'PostalAddress', streetAddress: 'Oba Mah., Mesut Cad., No: 54/A', postalCode: '07400', addressLocality: 'Alanya', addressRegion: 'Antalya', addressCountry: 'TR' },
    parentOrganization: { '@type': 'Organization', name: SITE.parent, url: SITE.parentUrl },
    sameAs: [SITE.instagram],
  },
  ...(crumbs.length
    ? [{
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        itemListElement: [{ label: tr("Главная"), href: '/' }, ...crumbs].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.label, ...(c.href ? { item: new URL(c.href, SITE.url).href } : {}) })),
      }]
    : []),
  ...jsonLd,
];
---
<!doctype html>
<html lang={LANG_META[lang].hreflang}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>document.documentElement.classList.add("js")</script>
    <script is:inline set:html={`window.__I18N__=${JSON.stringify(clientDict(lang))};window.T=function(s,v){var r=(window.__I18N__&&window.__I18N__[s])||s;if(v)for(var k in v)r=r.split("{"+k+"}").join(String(v[k]));return r};`} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={LANG_META[lang].og} />
    {alternates.map((a) => <link rel="alternate" hreflang={LANG_META[a.lang].hreflang} href={a.href} />)}
    <link rel="alternate" hreflang="x-default" href={alternates[0].href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#f5f5f5" />
    <link rel="preload" href="/fonts/EuclidCircularA-Regular.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/unbounded-cyrillic-wght-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={tr("Новости Stay Investment")} href="/news/rss.xml" />
    <script type="application/ld+json" set:html={JSON.stringify(ld.length === 1 ? ld[0] : ld)} />
  </head>
  <body class="min-h-dvh">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-full focus:bg-white focus:px-4 focus:py-2">{tr("К содержимому")}</a>
    <Header />
    {crumbs.length > 0 && (
      <nav class="container-x pt-6 text-[13.5px] text-muted" aria-label={tr("Хлебные крошки")}>
        <ol class="flex flex-wrap items-center gap-x-2 gap-y-1">
          <li><a href="/" class="hover:text-ink">{tr("Главная")}</a></li>
          {crumbs.map((c) => (
            <li class="flex items-center gap-2"><span aria-hidden="true">/</span>{c.href ? <a href={c.href} class="hover:text-ink">{c.label}</a> : <span class="text-ink-2" aria-current="page">{c.label}</span>}</li>
          ))}
        </ol>
      </nav>
    )}
    <main id="main"><slot /></main>
    <Footer />
    <VizTooltip />

    <a href={SITE.whatsapp} target="_blank" rel="noopener" class="wa-fab fixed bottom-5 right-5 z-30 grid h-14 w-14 place-items-center rounded-full bg-[#25d366] text-white shadow-lift hover:scale-105 active:scale-95" aria-label={tr("Написать в WhatsApp")}>
      <Icon name="whatsapp" size={28} stroke={1.6} />
    </a>

    <dialog id="lead-dialog" class="m-auto w-[min(520px,calc(100vw-32px))] rounded-[20px] bg-page p-0 text-ink shadow-lift">
      <div class="relative p-6 sm:p-8">
        <button type="button" class="absolute right-4 top-4 grid h-10 w-10 place-items-center rounded-full hover:bg-sand" aria-label={tr("Закрыть")} data-lead-close><Icon name="close" /></button>
        <p class="eyebrow">Stay Investment</p>
        <h2 class="mt-3 pr-10 text-2xl" data-lead-dialog-title>{tr("Консультация по инвестициям")}</h2>
        <p class="mt-2 text-[15px] text-ink-2">{tr("Расскажем об актуальных объектах, рассчитаем доходность под ваш бюджет и ответим на вопросы.")}</p>
        <div class="mt-6"><LeadForm source="modal" withComment compact /></div>
      </div>
    </dialog>

    <script>
      // Появление при прокрутке и счётчики цифр. При «уменьшить движение» — сразу финальное состояние.
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      const nf = new Intl.NumberFormat('ru-RU');
      const countUp = (el: HTMLElement) => {
        if (el.dataset.counted) return;
        el.dataset.counted = '1';
        const to = Number(el.dataset.count);
        if (reduce || !Number.isFinite(to)) { el.textContent = nf.format(to); return; }
        const t0 = performance.now(), dur = 1400;
        const ease = (t: number) => 1 - Math.pow(1 - t, 4);
        const tick = (now: number) => {
          const p = Math.min(1, (now - t0) / dur);
          el.textContent = nf.format(Math.round(to * ease(p)));
          if (p < 1) requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      };
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const el = e.target as HTMLElement;
          el.classList.add('is-in');
          el.querySelectorAll<HTMLElement>('[data-count]').forEach(countUp);
          if (el.dataset.count) countUp(el);
          io.unobserve(el);
        }
      }, { threshold: 0.15, rootMargin: '0px 0px -40px 0px' });
      document.querySelectorAll('[data-reveal], [data-count]').forEach((el) => io.observe(el));
      // Страховка от быстрой прокрутки (резкий свайп): всё, что уже выше нижнего края экрана, проявляем принудительно.
      let sweeping = false;
      const sweep = () => {
        sweeping = false;
        const limit = innerHeight;
        document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-in)').forEach((el) => {
          if (el.getBoundingClientRect().top < limit) {
            el.classList.add('is-in');
            el.querySelectorAll<HTMLElement>('[data-count]').forEach(countUp);
            io.unobserve(el);
          }
        });
      };
      addEventListener('scroll', () => { if (!sweeping) { sweeping = true; setTimeout(() => requestAnimationFrame(sweep), 120); } }, { passive: true });

      const dlg = document.getElementById('lead-dialog') as HTMLDialogElement | null;
      document.addEventListener('click', (e) => {
        const open = (e.target as HTMLElement).closest<HTMLElement>('[data-lead-open]');
        if (open && dlg) {
          e.preventDefault();
          dlg.querySelector('[data-lead-dialog-title]')!.textContent = open.dataset.leadTitle || T('Консультация по инвестициям');
          const src = dlg.querySelector<HTMLInputElement>('input[name="source"]')!;
          src.value = `${location.pathname}#${open.dataset.leadSource || 'modal'}`;
          let obj = dlg.querySelector<HTMLInputElement>('input[name="object"]');
          if (open.dataset.leadObject) {
            if (!obj) { obj = Object.assign(document.createElement('input'), { type: 'hidden', name: 'object' }); src.after(obj); }
            obj.value = open.dataset.leadObject;
          } else obj?.remove();
          dlg.showModal();
        }
        if ((e.target as HTMLElement).closest('[data-lead-close]') || e.target === dlg) dlg?.close();
      });

      document.addEventListener('submit', async (e) => {
        const form = (e.target as HTMLElement).closest<HTMLFormElement>('[data-lead-form]');
        if (!form) return;
        e.preventDefault();
        const status = form.querySelector<HTMLElement>('[data-lead-status]')!;
        const show = (ok: boolean, text: string) => {
          status.textContent = text;
          status.className = `rounded-xl px-4 py-3 text-[14px] font-semibold ${ok ? 'bg-sea-soft text-sea' : 'bg-sea-soft text-brand-2'}`;
        };
        if (!form.checkValidity()) { form.reportValidity(); return; }
        const btn = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
        btn.disabled = true;
        try {
          const data = Object.fromEntries(new FormData(form).entries());
          if (!String(data.source).startsWith('/')) data.source = `${location.pathname}#${data.source}`;
          const r = await fetch('/api/lead/', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(data) });
          if (!r.ok) throw new Error(String(r.status));
          form.reset();
          show(true, T('Спасибо! Заявка принята — консультант свяжется с вами в ближайшее время.'));
        } catch {
          show(false, T('Не получилось отправить заявку. Напишите нам в WhatsApp или позвоните — ответим сразу.'));
        } finally {
          btn.disabled = false;
        }
      });
    </script>
  </body>
</html>
