---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV, SITE } from '../lib/site';
const path = Astro.url.pathname;
const active = (href: string) => href !== '/' && path.startsWith(href.replace(/\/$/, '').split('/').slice(0, 2).join('/'));
---
<header class="sticky top-0 z-40 border-b border-line/70 bg-page/85 backdrop-blur-md">
  <div class="container-x flex h-[72px] items-center gap-6">
    <Logo class="h-6 md:h-7" />
    <nav class="ml-4 hidden flex-1 items-center gap-1 lg:flex" aria-label="Основное меню">
      {NAV.map((item) => (
        <div class="group relative">
          <a href={item.href} class:list={['flex items-center gap-1 whitespace-nowrap rounded-full px-3 py-2 text-[15px] font-semibold transition-colors hover:text-accent-2', active(item.href) ? 'text-accent-2' : 'text-ink']}>
            {item.label}
            {item.children && <Icon name="chevron" size={16} class="opacity-60 transition-transform group-hover:rotate-180" />}
          </a>
          {item.children && (
            <div class="invisible absolute left-0 top-full pt-2 opacity-0 transition-all duration-150 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
              <div class="card w-[320px] p-2">
                {item.children.map((c) => (
                  <a href={c.href} class="block rounded-xl px-4 py-3 hover:bg-page">
                    <span class="block text-[15px] font-bold text-ink">{c.label}</span>
                    {c.note && <span class="mt-0.5 block text-[13px] text-muted">{c.note}</span>}
                  </a>
                ))}
              </div>
            </div>
          )}
        </div>
      ))}
    </nav>
    <div class="ml-auto flex items-center gap-2">
      <a href={SITE.phoneHref} class="hidden items-center gap-2 whitespace-nowrap px-2 text-[15px] font-bold tabular 2xl:flex"><Icon name="phone" size={18} class="text-accent" />{SITE.phone}</a>
      <a href={SITE.whatsapp} class="btn btn-ghost btn-sm hidden sm:inline-flex" target="_blank" rel="noopener" aria-label="Написать в WhatsApp"><Icon name="whatsapp" size={18} />WhatsApp</a>
      <button type="button" class="btn btn-primary btn-sm hidden md:inline-flex" data-lead-open data-lead-title="Заказать звонок" data-lead-source="header">Консультация</button>
      <button type="button" class="grid h-11 w-11 place-items-center rounded-full border border-line-2 lg:hidden" aria-label="Открыть меню" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <Icon name="menu" size={22} />
      </button>
    </div>
  </div>
  <div id="mobile-menu" class="hidden border-t border-line bg-page lg:hidden" data-menu>
    <nav class="container-x max-h-[calc(100dvh-72px)] overflow-y-auto py-4" aria-label="Мобильное меню">
      {NAV.map((item) => (
        <div class="border-b border-line py-2 last:border-0">
          <a href={item.href} class="block py-2 text-lg font-bold">{item.label}</a>
          {item.children && (
            <div class="pb-2">
              {item.children.map((c) => <a href={c.href} class="block py-1.5 pl-3 text-[15px] text-ink-2">{c.label}</a>)}
            </div>
          )}
        </div>
      ))}
      <div class="mt-4 grid gap-2">
        <a href={SITE.phoneHref} class="btn btn-ghost"><Icon name="phone" size={18} />{SITE.phone}</a>
        <button type="button" class="btn btn-primary" data-lead-open data-lead-title="Заказать звонок" data-lead-source="mobile-menu">Получить консультацию</button>
      </div>
    </nav>
  </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  btn?.addEventListener('click', () => {
    const open = menu!.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  });
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a,button')) { menu.classList.add('hidden'); btn?.setAttribute('aria-expanded', 'false'); document.body.style.overflow = ''; }
  });
</script>
