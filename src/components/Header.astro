---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { NAV, SITE } from '../lib/site';
// Направления группы — как в шапке stay.com.tr; Stay Investment — текущий сайт
const GROUP = [
  { label: 'STAY PROJECTS', href: 'https://stay.com.tr/ru/turkey/sale/complexes/' },
  { label: 'STAY PROPERTY', href: 'https://stay.com.tr/ru/turkey/sale/' },
  { label: 'PRIVE', href: 'https://stay.com.tr/ru/prive/' },
  { label: 'RENTAL', href: 'https://stay.com.tr/ru/turkey/rent/' },
  { label: 'INVESTMENT', href: '/', current: true },
];
const path = Astro.url.pathname;
const active = (href: string) => href !== '/' && path.startsWith(href.replace(/\/$/, '').split('/').slice(0, 2).join('/'));
---
<header class="sticky top-0 z-40 border-b border-line bg-page/90 backdrop-blur-md">
  <!-- Верхняя строка (как на stay.com.tr): знак группы, направления Stay, контакты -->
  <div>
    <div class="container-x flex h-[60px] items-center gap-4 lg:h-[64px]">
      <Logo class="h-[22px] lg:h-[24px]" />
      <nav class="hidden items-center xl:flex" aria-label="Направления группы Stay">
        {GROUP.map((g) => (
          <a href={g.href} aria-current={g.current ? 'true' : undefined} class:list={['flex items-center whitespace-nowrap font-[family-name:var(--font-display)] text-[11px] leading-none tracking-[.04em] transition-colors', g.current ? 'text-ink' : 'text-muted hover:text-ink']}>
            <span class="mx-4 h-[16px] w-px bg-line-2" aria-hidden="true"></span>{g.label}
          </a>
        ))}
      </nav>
      <div class="ml-auto flex items-center gap-2 sm:gap-3">
        <a href={SITE.phoneHref} class="hidden items-center gap-2 whitespace-nowrap px-1 text-[15px] font-medium tabular hover:text-brand-2 md:flex" aria-label={`Позвонить: ${SITE.phone}`}>
          <Icon name="phone" size={18} />
          <span class="xl:hidden 2xl:inline">{SITE.phone}</span>
        </a>
        <a href={SITE.whatsapp} class="hidden h-10 w-10 place-items-center rounded-full border border-line-2 bg-surface transition-colors hover:border-ink sm:grid" target="_blank" rel="noopener" aria-label="Написать в WhatsApp"><Icon name="whatsapp" size={18} class="text-[#1a9e4b]" /></a>
        <button type="button" class="btn btn-primary btn-sm hidden md:inline-flex" data-lead-open data-lead-title="Обратный звонок" data-lead-source="header">Обратный звонок</button>
        <button type="button" class="group/menu relative grid h-11 w-11 place-items-center rounded-full border border-line-2 bg-surface lg:hidden" aria-label="Меню" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
          <!-- Иконки сменяются через opacity+scale+blur (контекстная анимация иконок) -->
          <Icon name="menu" size={22} class="col-start-1 row-start-1 transition-[opacity,scale,filter] duration-200 group-aria-expanded/menu:scale-50 group-aria-expanded/menu:opacity-0 group-aria-expanded/menu:blur-[2px] motion-reduce:transition-none" />
          <Icon name="close" size={22} class="col-start-1 row-start-1 scale-50 opacity-0 blur-[2px] transition-[opacity,scale,filter] duration-200 group-aria-expanded/menu:scale-100 group-aria-expanded/menu:opacity-100 group-aria-expanded/menu:blur-0 motion-reduce:transition-none" />
        </button>
      </div>
    </div>
  </div>
  <!-- Нижняя строка: меню + главное действие -->
  <div class="hidden border-t border-line lg:block">
    <div class="container-x flex h-[56px] items-center gap-2">
      <nav class="-ml-3 flex items-center gap-1" aria-label="Основное меню">
        {NAV.map((item) => (
          <div class="group relative">
            <a href={item.href} class:list={['flex items-center gap-1 whitespace-nowrap rounded-full px-3 py-2 text-[15px] transition-colors hover:bg-[#d0d1d74d]', active(item.href) ? 'bg-[#d0d1d74d] text-ink' : 'text-ink-2']}>
              {item.label}
              {item.children && <Icon name="chevron" size={16} class="opacity-60 transition-transform group-hover:rotate-180" />}
            </a>
            {item.children && (
              <div class="invisible absolute left-0 top-full pt-2 opacity-0 transition-[opacity,visibility] duration-150 ease-out group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
                <div class="card w-[320px] origin-top scale-[.97] p-2 transition-transform duration-200 [transition-timing-function:var(--ease-out-quart)] group-hover:scale-100 group-focus-within:scale-100">
                  {item.children.map((c) => (
                    <a href={c.href} class="block rounded-xl px-4 py-3 hover:bg-page">
                      <span class="block text-[15px] font-semibold text-ink">{c.label}</span>
                      {c.note && <span class="mt-0.5 block text-[13px] text-muted">{c.note}</span>}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        ))}
      </nav>
      <a href="/investment-directory/" class="btn btn-accent btn-sm ml-auto">Подобрать инвестицию<Icon name="arrow" size={16} /></a>
    </div>
  </div>
  <div id="mobile-menu" class="absolute inset-x-0 top-full border-t border-line bg-page shadow-lift lg:hidden" data-menu>
    <nav class="container-x max-h-[calc(100dvh-64px)] overflow-y-auto py-4" aria-label="Мобильное меню">
      {NAV.map((item) => (
        <div class="border-b border-line py-2 last:border-0">
          <a href={item.href} class="block py-2 text-lg font-bold">{item.label}</a>
          {item.children && (
            <div class="pb-2">
              {item.children.map((c) => <a href={c.href} class="block py-1.5 pl-3 text-[15px] text-ink-2">{c.label}</a>)}
            </div>
          )}
        </div>
      ))}
      <div class="mt-4 grid gap-2">
        <a href={SITE.phoneHref} class="btn btn-ghost"><Icon name="phone" size={18} />{SITE.phone}</a>
        <button type="button" class="btn btn-primary" data-lead-open data-lead-title="Заказать звонок" data-lead-source="mobile-menu">Получить консультацию</button>
      </div>
    </nav>
  </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const setOpen = (open: boolean) => {
    menu!.toggleAttribute('data-open', open);
    btn!.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };
  btn?.addEventListener('click', () => setOpen(!menu!.hasAttribute('data-open')));
  menu?.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a,button')) setOpen(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && menu?.hasAttribute('data-open')) { setOpen(false); btn?.focus(); } });
</script>
