---
/**
 * График платежей объекта: первый взнос + беспроцентная рассрочка.
 * Сегментированная полоса (одно целое — 100% цены) + три показателя. Для партнёрских проектов не показывается.
 */
import { entryPrice, euro, type InvestObject } from '../lib/catalog';
interface Props { o: InvestObject }
const { o } = Astro.props;
const price = entryPrice(o);
const first = o.metrics.find((m) => m.label === '1й платеж')?.value ?? null;
const months = o.metrics.find((m) => /рассрочки/.test(m.label))?.value ?? null;
const show = price != null && first != null && months != null && first < 100;
const firstEur = show ? (price! * first!) / 100 : 0;
const monthly = show ? (price! - firstEur) / months! : 0;
---
{show && (
  <section class="card p-6 md:p-8" aria-labelledby="plan-title">
    <h2 id="plan-title" class="text-2xl">График платежей</h2>
    <p class="mt-1 text-[15px] text-ink-2">Беспроцентная рассрочка от застройщика. Расчёт — от минимальной стоимости {euro(price)}.</p>
    <div class="mt-6 flex h-[28px] gap-[2px]" role="img" aria-label={`Первый взнос ${first}% — ${euro(firstEur)}; рассрочка ${100 - first!}% — ${euro(price! - firstEur)} на ${months} мес.`}>
      <span class="flex items-center rounded-[4px] bg-navy px-2.5 text-[12.5px] font-bold text-white" style={`width:${first}%`} tabindex="0" data-tip={`${euro(firstEur)}|Первый взнос · ${first}% стоимости`}>{first}%</span>
      <span class="flex items-center rounded-[4px] bg-[#c9d3e0] px-2.5 text-[12.5px] font-bold text-ink" style={`width:${100 - first!}%`} tabindex="0" data-tip={`${euro(price! - firstEur)}|Рассрочка · ${100 - first!}% на ${months} мес.`}>{100 - first!}%</span>
    </div>
    <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-[13px] text-ink-2">
      <li class="flex items-center gap-2"><span class="legend-key bg-navy"></span>Первый взнос</li>
      <li class="flex items-center gap-2"><span class="legend-key bg-[#c9d3e0]"></span>Рассрочка без процентов</li>
    </ul>
    <dl class="mt-6 grid grid-cols-3 gap-4 border-t border-line pt-5">
      <div><dt class="text-[13px] text-muted">Первый взнос</dt><dd class="mt-1 text-xl font-extrabold">{euro(Math.round(firstEur))}</dd></div>
      <div><dt class="text-[13px] text-muted">Платёж в месяц</dt><dd class="mt-1 text-xl font-extrabold">≈ {euro(Math.round(monthly / 10) * 10)}</dd></div>
      <div><dt class="text-[13px] text-muted">Срок</dt><dd class="mt-1 text-xl font-extrabold">{months} мес.</dd></div>
    </dl>
  </section>
)}
