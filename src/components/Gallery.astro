---
/**
 * Галерея объекта: плавная смена фото (crossfade 220 мс), стрелки, свайп, клавиатура (← →),
 * миниатюры и полноэкранный просмотр (dialog). Размеры фото — src/lib/img.ts.
 * При prefers-reduced-motion смена без анимации.
 */
import Img from './Img.astro';
import Icon from './Icon.astro';
import { langOf, useT } from '../i18n';
import { imgUrl } from '../lib/img';
interface Props { images: string[]; title: string }
const lang = langOf(Astro.locals);
const tr = useT(lang);
const { images, title } = Astro.props;
const list = images.slice(0, 24);
// Адреса для смены кадра (1280 px) и полноэкранного просмотра (1920 px) считаем на сервере — src/lib/img.ts
const mid = list.map((s) => imgUrl(s, 1280));
const full = list.map((s) => imgUrl(s, 1920));
---
<div class="min-w-0" data-gallery data-images={JSON.stringify(mid)} data-full={JSON.stringify(full)}>
  <div class="group/g img-outline relative overflow-hidden rounded-[20px] bg-sand" data-stage tabindex="0" aria-roledescription={tr("галерея")} aria-label={tr("Фото объекта: {title}", { title })}>
    <Img src={list[0]} alt={title} class="aspect-[16/10] w-full select-none" width={1280} height={800} priority sizes="(min-width: 1024px) 60vw, 100vw" />
    {list.length > 1 && (
      <>
        <button type="button" class="absolute left-3 top-1/2 z-[2] grid h-11 w-11 -translate-y-1/2 place-items-center rounded-full bg-white/95 text-ink shadow-card transition-[opacity,scale] duration-200 hover:scale-105 active:scale-95 sm:opacity-0 sm:group-hover/g:opacity-100 sm:focus-visible:opacity-100" data-prev aria-label={tr("Предыдущее фото")}><Icon name="chevron" size={20} stroke={2.2} class="rotate-90" /></button>
        <button type="button" class="absolute right-3 top-1/2 z-[2] grid h-11 w-11 -translate-y-1/2 place-items-center rounded-full bg-white/95 text-ink shadow-card transition-[opacity,scale] duration-200 hover:scale-105 active:scale-95 sm:opacity-0 sm:group-hover/g:opacity-100 sm:focus-visible:opacity-100" data-next aria-label={tr("Следующее фото")}><Icon name="chevron" size={20} stroke={2.2} class="-rotate-90" /></button>
        <span class="chip absolute bottom-4 left-4 z-[2] bg-navy/80 text-white tabular" data-counter aria-live="polite">1 / {list.length}</span>
      </>
    )}
    <button type="button" class="absolute bottom-3 right-3 z-[2] grid h-11 w-11 place-items-center rounded-full bg-white/95 text-ink shadow-card transition-[scale] duration-200 hover:scale-105 active:scale-95" data-zoom aria-label={tr("Открыть фото на весь экран")}>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 9V4h5M20 9V4h-5M4 15v5h5M20 15v5h-5" /></svg>
    </button>
  </div>
  {list.length > 1 && (
    <div class="mt-3 flex gap-2 overflow-x-auto pb-1" data-thumbs>
      {list.map((src, i) => (
        <button type="button" class:list={['h-16 w-24 shrink-0 overflow-hidden rounded-xl ring-2 ring-offset-2 ring-offset-page transition-[box-shadow,opacity] duration-200', i === 0 ? 'ring-brand' : 'ring-transparent opacity-80 hover:opacity-100']} data-thumb={i} aria-label={tr("Фото {i1}", { i1: i + 1 })}>
          <Img src={src} alt="" class="h-full w-full" width={192} height={128} sizes="96px" />
        </button>
      ))}
    </div>
  )}

  <dialog class="gallery-box m-0 h-dvh max-h-none w-screen max-w-none bg-transparent p-0" data-box aria-label={tr("Фото: {title}", { title })}>
    <div class="relative grid h-full w-full place-items-center p-4 sm:p-10" data-box-stage>
      <img alt={title} width="1920" height="1200" class="h-auto max-h-full w-auto max-w-full rounded-[12px] object-contain shadow-lift" data-box-img />
      <button type="button" class="absolute right-4 top-4 grid h-11 w-11 place-items-center rounded-full bg-white text-ink shadow-card" data-box-close aria-label={tr("Закрыть")}><Icon name="close" size={22} /></button>
      {list.length > 1 && (
        <>
          <button type="button" class="absolute left-3 top-1/2 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full bg-white text-ink shadow-card active:scale-95" data-box-prev aria-label={tr("Предыдущее фото")}><Icon name="chevron" size={22} stroke={2.2} class="rotate-90" /></button>
          <button type="button" class="absolute right-3 top-1/2 grid h-12 w-12 -translate-y-1/2 place-items-center rounded-full bg-white text-ink shadow-card active:scale-95" data-box-next aria-label={tr("Следующее фото")}><Icon name="chevron" size={22} stroke={2.2} class="-rotate-90" /></button>
          <span class="chip absolute bottom-5 left-1/2 -translate-x-1/2 bg-white text-ink tabular" data-box-counter></span>
        </>
      )}
    </div>
  </dialog>
</div>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const EASE = 'cubic-bezier(0.165, 0.84, 0.44, 1)';
  for (const g of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
    const images: string[] = JSON.parse(g.dataset.images || '[]');
    const full: string[] = JSON.parse(g.dataset.full || '[]');
    const stage = g.querySelector<HTMLElement>('[data-stage]')!;
    const main = stage.querySelector<HTMLImageElement>('img')!;
    const counter = g.querySelector('[data-counter]');
    const thumbs = [...g.querySelectorAll<HTMLButtonElement>('[data-thumb]')];
    const box = g.querySelector<HTMLDialogElement>('[data-box]')!;
    const boxImg = box.querySelector<HTMLImageElement>('[data-box-img]')!;
    const boxCounter = box.querySelector('[data-box-counter]');
    let i = 0;

    const show = (n: number, dir = 1) => {
      if (!images.length) return;
      i = (n + images.length) % images.length;
      const next = new Image();
      next.src = images[i];
      next.alt = main.alt;
      next.className = main.className;
      next.style.cssText = 'position:absolute;inset:0;width:100%;height:100%;object-fit:cover';
      const done = () => { main.removeAttribute('srcset'); main.src = next.src; next.remove(); };
      if (reduce) { done(); }
      else {
        stage.insertBefore(next, main.nextSibling);
        next.decode().catch(() => {}).finally(() => {
          next.animate([{ opacity: 0, translate: `${dir * 16}px 0` }, { opacity: 1, translate: '0 0' }], { duration: 220, easing: EASE }).finished.then(done);
        });
      }
      if (counter) counter.textContent = `${i + 1} / ${images.length}`;
      thumbs.forEach((t, k) => {
        const on = k === i;
        t.classList.toggle('ring-brand', on); t.classList.toggle('ring-transparent', !on); t.classList.toggle('opacity-80', !on);
        if (on) t.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: reduce ? 'auto' : 'smooth' });
      });
      if (box.open) showBox();
    };
    const showBox = () => {
      boxImg.src = full[i] ?? images[i];
      if (boxCounter) boxCounter.textContent = `${i + 1} / ${images.length}`;
      if (!reduce) boxImg.animate([{ opacity: 0, scale: 0.98 }, { opacity: 1, scale: 1 }], { duration: 200, easing: EASE });
    };

    g.querySelector('[data-prev]')?.addEventListener('click', () => show(i - 1, -1));
    g.querySelector('[data-next]')?.addEventListener('click', () => show(i + 1, 1));
    thumbs.forEach((t, k) => t.addEventListener('click', () => show(k, k > i ? 1 : -1)));
    stage.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(i + 1, 1);
      if (e.key === 'ArrowLeft') show(i - 1, -1);
      if (e.key === 'Enter') { box.showModal(); showBox(); }
    });

    // Свайп: горизонтальный жест длиннее 40 px листает фото, вертикальный оставляем прокрутке страницы
    const swipe = (el: HTMLElement) => {
      let x0 = 0, y0 = 0, active = false;
      el.addEventListener('pointerdown', (e) => { if (e.pointerType === 'mouse') return; x0 = e.clientX; y0 = e.clientY; active = true; });
      el.addEventListener('pointerup', (e) => {
        if (!active) return; active = false;
        const dx = e.clientX - x0, dy = e.clientY - y0;
        if (Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.5) show(i + (dx < 0 ? 1 : -1), dx < 0 ? 1 : -1);
      });
      el.style.touchAction = 'pan-y';
    };
    swipe(stage);
    swipe(box.querySelector<HTMLElement>('[data-box-stage]')!);

    g.querySelector('[data-zoom]')?.addEventListener('click', () => { box.showModal(); showBox(); });
    box.querySelector('[data-box-close]')?.addEventListener('click', () => box.close());
    box.querySelector('[data-box-prev]')?.addEventListener('click', () => show(i - 1, -1));
    box.querySelector('[data-box-next]')?.addEventListener('click', () => show(i + 1, 1));
    box.addEventListener('click', (e) => { if (e.target === box || e.target === box.querySelector('[data-box-stage]')) box.close(); });
    box.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') show(i + 1, 1);
      if (e.key === 'ArrowLeft') show(i - 1, -1);
    });
  }
</script>
