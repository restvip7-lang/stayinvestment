---
import { langOf, useT } from '../i18n';
/** Вопросы и ответы + разметка FAQPage для поисковиков. */
interface Props { items: { q: string; a: string }[]; title?: string }
const lang = langOf(Astro.locals);
const tr = useT(lang);
const { items, title = tr("Частые вопросы") } = Astro.props;
const ld = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: items.map((i) => ({ '@type': 'Question', name: i.q, acceptedAnswer: { '@type': 'Answer', text: i.a } })) };
---
<section class="container-x py-16 md:py-24">
  <div class="grid gap-10 lg:grid-cols-[1fr_2fr]">
    <div data-reveal>
      <p class="eyebrow">FAQ</p>
      <h2 class="h-section mt-3">{title}</h2>
    </div>
    <div class="divide-y divide-line border-y border-line">
      {items.map((i, k) => (
        <details class="faq group py-5" data-reveal style={`--i:${k % 4}`}>
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-[17px] font-bold [&::-webkit-details-marker]:hidden">
            {i.q}
            <span class="mt-1 grid h-7 w-7 shrink-0 place-items-center rounded-full border border-line-2 text-lg leading-none transition-transform duration-200 group-open:rotate-45 group-open:border-brand group-open:text-brand-2" aria-hidden="true">+</span>
          </summary>
          <div class="faq-body"><p class="mt-3 max-w-3xl text-[16px] leading-relaxed text-ink-2">{i.a}</p></div>
        </details>
      ))}
    </div>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</section>
