---
/**
 * Иллюстрация кабинета инвестора (макет интерфейса). Все цифры — условные и подписаны как пример,
 * чтобы их не приняли за данные реального проекта.
 */
import Icon from './Icon.astro';
const months = [8, 15, 22, 31, 40, 48, 57, 63, 68];
---
<figure class="card overflow-hidden" aria-label="Пример интерфейса кабинета инвестора, данные условные">
  <div class="flex items-center gap-2 border-b border-line bg-sand px-4 py-3">
    <span class="h-3 w-3 rounded-full bg-[#ff5f57]"></span><span class="h-3 w-3 rounded-full bg-[#febc2e]"></span><span class="h-3 w-3 rounded-full bg-[#28c840]"></span>
    <span class="ml-3 truncate rounded-lg bg-surface px-3 py-1 text-[12px] text-muted">stayinvestment.com/cabinet</span>
    <span class="chip ml-auto shrink-0 bg-accent-soft text-accent-2">Пример · данные условные</span>
  </div>
  <div class="grid gap-4 p-4 sm:p-6 lg:grid-cols-[1.3fr_1fr]">
    <div class="relative overflow-hidden rounded-[14px] bg-gradient-to-br from-[#3a4a5c] to-[#1f2733] p-5 text-white" data-reveal>
      <div class="flex items-center gap-2 text-[12px] font-semibold">
        <span class="live-dot h-2.5 w-2.5 rounded-full bg-accent"></span>LIVE · Камера 1, строительная площадка
      </div>
      <svg viewBox="0 0 320 150" class="mt-4 w-full" aria-hidden="true">
        <rect x="0" y="120" width="320" height="30" fill="#ffffff14" />
        <rect x="40" y="40" width="90" height="80" fill="#ffffff22" /><rect x="40" y="40" width="90" height="10" fill="#ffffff33" />
        <rect x="150" y="20" width="110" height="100" fill="#ffffff1c" /><rect x="150" y="20" width="110" height="10" fill="#ffffff2e" />
        {[0, 1, 2, 3].map((r) => [0, 1, 2].map((c) => <rect x={160 + c * 33} y={40 + r * 20} width="22" height="12" fill="#ffffff26" />))}
        {[0, 1, 2].map((r) => [0, 1].map((c) => <rect x={52 + c * 38} y={60 + r * 18} width="26" height="10" fill="#ffffff26" />))}
        <path d="M270 120V8M270 8h40M300 8v26" stroke="#ffffff55" stroke-width="3" fill="none" />
      </svg>
      <p class="mt-3 text-[12px] text-white/70">Трансляция 24/7 · обновлено только что</p>
    </div>
    <div class="grid content-start gap-4">
      <div class="rounded-[14px] border border-line p-4" data-reveal style="--i:1">
        <p class="text-[12.5px] text-muted">Готовность объекта</p>
        <p class="mt-1 text-2xl font-bold tabular"><span data-count="68">68</span>%</p>
        <div class="mt-3 h-2 overflow-hidden rounded-full bg-sand"><div class="bar-grow h-full rounded-full bg-brand" style="width:68%"></div></div>
      </div>
      <div class="rounded-[14px] border border-line p-4" data-reveal style="--i:2">
        <p class="text-[12.5px] text-muted">Продано квартир</p>
        <p class="mt-1 text-2xl font-bold tabular"><span data-count="34">34</span> <span class="text-base font-medium text-muted">из 54</span></p>
        <div class="mt-3 flex h-10 items-end gap-1" aria-hidden="true">
          {months.map((v, i) => <span class="bar-grow-y w-full rounded-t-[3px] bg-[#16a085]" style={`height:${(v / 68) * 100}%;transition-delay:${i * 50}ms`}></span>)}
        </div>
      </div>
      <div class="grid grid-cols-2 gap-3 text-[13px]" data-reveal style="--i:3">
        <span class="flex items-center gap-2 rounded-[12px] bg-page px-3 py-2.5"><Icon name="camera" size={16} class="text-brand" />Фотоотчёт · ноябрь</span>
        <span class="flex items-center gap-2 rounded-[12px] bg-page px-3 py-2.5"><Icon name="doc" size={16} class="text-brand" />Договор и разрешения</span>
      </div>
    </div>
  </div>
</figure>
