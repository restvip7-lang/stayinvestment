---
/** Общая подсказка для инфографики: любой элемент с data-tip показывает её при наведении и фокусе. Текст — через textContent. */
---
<div class="viz-tip hidden" role="tooltip" id="viz-tip"></div>
<script>
  const tip = document.getElementById('viz-tip')!;
  let current: HTMLElement | null = null;
  const show = (el: HTMLElement) => {
    current = el;
    const [head, ...rest] = (el.dataset.tip ?? '').split('|');
    tip.replaceChildren();
    const b = document.createElement('b');
    b.textContent = head;
    tip.append(b);
    for (const line of rest) { tip.append(document.createElement('br'), document.createTextNode(line)); }
    tip.classList.remove('hidden');
    const r = el.getBoundingClientRect();
    tip.style.left = `${Math.min(window.innerWidth - 12 - tip.offsetWidth / 2, Math.max(12 + tip.offsetWidth / 2, r.left + r.width / 2)) + window.scrollX}px`;
    tip.style.top = `${r.top + window.scrollY}px`;
  };
  const hide = () => { current = null; tip.classList.add('hidden'); };
  document.addEventListener('pointerover', (e) => { const el = (e.target as HTMLElement).closest<HTMLElement>('[data-tip]'); if (el) show(el); else if (current) hide(); });
  document.addEventListener('focusin', (e) => { const el = (e.target as HTMLElement).closest<HTMLElement>('[data-tip]'); if (el) show(el); });
  document.addEventListener('focusout', hide);
  window.addEventListener('scroll', () => current && show(current), { passive: true });
</script>
