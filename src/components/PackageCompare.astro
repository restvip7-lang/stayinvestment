---
/**
 * Сравнение четырёх пакетов. Числа «Рантье», «Стартового» и «Партнерского» — из каталога (packageStats).
 * У «Инвестиций в бизнес» объектов в каталоге нет, поэтому цифр нет — только условия, без выдуманных значений.
 * Телефон — вкладки, планшет и десктоп — таблица.
 */
import { PACKAGES, PACKAGE_ORDER, packageStats, fmtRange, eurShort, pkgColor, type PackageKey } from '../lib/catalog';
import { langOf, useT } from '../i18n';

type Col = PackageKey | 'business';
const lang = langOf(Astro.locals);
const tr = useT(lang);
const s = Object.fromEntries(PACKAGE_ORDER.map((k) => [k, packageStats(k)])) as Record<PackageKey, ReturnType<typeof packageStats>>;
const entry = (k: PackageKey) => (s[k].entry ? tr("от {min}", { min: eurShort(s[k].entry!.min, lang) }) : '—');

const COLS: { key: Col; name: string; short: string; href: string; color: string; note: string }[] = [
  ...PACKAGE_ORDER.map((k) => ({ key: k as Col, name: tr(PACKAGES[k].name), short: tr(PACKAGES[k].name), href: `/investment-directory/${k}/`, color: pkgColor(k), note: tr("{count} объектов в каталоге", { count: s[k].count }) })),
  { key: 'business', name: tr("Инвестиции в бизнес"), short: tr("Бизнес"), href: '/investment-directory/biznes-investitsii/', color: 'var(--color-ink-2)', note: tr("подбор под запрос") },
];

const rows: { label: string; hint?: string; cells: Record<Col, string> }[] = [
  { label: tr("Цель"), cells: { rental: tr("Регулярный арендный доход"), startovye: tr("Рост капитала к сдаче дома"), partnerskye: tr("Доход от девелоперского проекта"), business: tr("Доход от коммерческой недвижимости или бизнеса") } },
  { label: tr("Вход"), hint: tr("Минимальная сумма по объектам каталога"), cells: { rental: entry('rental'), startovye: entry('startovye'), partnerskye: entry('partnerskye'), business: tr("По запросу") } },
  {
    label: tr("Доходность"),
    hint: tr("По условиям объектов в каталоге. Прогноз, не гарантия"),
    cells: {
      rental: tr("{rentYield} годовых", { rentYield: fmtRange(s.rental.rentYield, '%', lang) }),
      startovye: tr("≈ 15–20% за цикл") + (s.startovye.discount ? tr(" · скидка {discount}", { discount: fmtRange(s.startovye.discount, '%', lang) }) : ''),
      partnerskye: tr("ROI {roi} за цикл", { roi: fmtRange(s.partnerskye.roi, '%', lang) }),
      business: tr("Индивидуальный расчёт под объект"),
    },
  },
  {
    label: tr("Горизонт"),
    cells: {
      rental: tr("гарантия аренды {guaranteeYears} лет, дальше — без ограничений", { guaranteeYears: fmtRange(s.rental.guaranteeYears) }),
      startovye: tr("до сдачи дома, обычно 12–24 мес."),
      partnerskye: tr("{paybackMonths} мес.", { paybackMonths: fmtRange(s.partnerskye.paybackMonths) }),
      business: tr("Зависит от объекта"),
    },
  },
  { label: tr("Как приходит доход"), cells: { rental: tr("Ежегодные выплаты от управляющей компании"), startovye: tr("Разовый — при перепродаже (или аренда)"), partnerskye: tr("Разовый — распределение прибыли по итогам продаж"), business: tr("Арендные платежи или прибыль бизнеса") } },
  { label: tr("Рассрочка"), cells: { rental: tr("без процентов: первый взнос от {min}%, срок до {max} мес.", { min: s.rental.firstPayment?.min ?? '—', max: s.rental.installmentMonths?.max ?? '—' }), startovye: tr("без процентов: первый взнос от {min}%, срок до {max} мес.", { min: s.startovye.firstPayment?.min ?? '—', max: s.startovye.installmentMonths?.max ?? '—' }), partnerskye: tr("нет — вход единой суммой"), business: tr("Зависит от объекта") } },
  { label: tr("Ликвидность"), hint: tr("Насколько быстро можно выйти из вложения"), cells: { rental: tr("Высокая: готовая квартира, можно продать"), startovye: tr("Средняя: до сдачи — переуступка договора, после — обычная продажа"), partnerskye: tr("Низкая: выход по итогам цикла проекта"), business: tr("Зависит от объекта и рынка") } },
  { label: tr("Чем владеете"), cells: { rental: tr("Квартира с ТАПУ на ваше имя"), startovye: tr("Квартира в строящемся доме, ТАПУ после сдачи"), partnerskye: tr("Доля в проекте по инвестиционному договору"), business: tr("Коммерческий объект или доля в бизнесе") } },
  { label: tr("Обеспечение"), cells: { rental: tr("Право собственности (ТАПУ)"), startovye: tr("Договор купли-продажи, ТАПУ после сдачи"), partnerskye: tr("Нотариус, вексель, ипотека или ТАПУ на квартиры"), business: tr("Право собственности или договор — по сделке") } },
  { label: tr("Профиль риска"), cells: { rental: tr("Консервативный"), startovye: tr("Умеренный"), partnerskye: tr("Выше среднего"), business: tr("Оценивается по объекту") } },
];
---
<!-- Телефон: одна карточка, пакеты переключаются вкладками — без горизонтальной прокрутки -->
<div class="card overflow-hidden md:hidden" data-pkg-tabs>
  <div class="grid grid-cols-2 gap-1 border-b border-line p-1.5 min-[420px]:grid-cols-4" role="tablist" aria-label={tr("Пакет")}>
    {COLS.map(({ key: k, short, color }, i) => (
      <button type="button" role="tab" id={`pc-tab-${k}`} aria-controls={`pc-panel-${k}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}
        class="flex min-h-12 min-w-0 flex-col items-center justify-center gap-1 rounded-xl px-0.5 text-[13px] font-extrabold text-muted aria-selected:bg-page aria-selected:text-ink" data-tab={k}>
        <span class="max-w-full truncate">{short}</span>
        <span class="h-[3px] w-6 rounded-full" style={`background:${color}`} aria-hidden="true"></span>
      </button>
    ))}
  </div>
  {COLS.map(({ key: k, name, href, note }, i) => (
    <div role="tabpanel" id={`pc-panel-${k}`} aria-labelledby={`pc-tab-${k}`} hidden={i !== 0} data-panel={k}>
      <p class="px-5 pt-4 text-[13px] text-muted"><span class="font-bold text-ink">«{name}»</span> · {note} · <a href={href} class="font-bold text-sea underline underline-offset-2">{tr("подробнее о пакете")}</a></p>
      <dl class="divide-y divide-line px-5 pb-2">
        {rows.map((r) => (
          <div class="grid grid-cols-[38%_1fr] gap-3 py-3">
            <dt class="text-[13px] font-bold leading-snug">{r.label}</dt>
            <dd class="text-[14px] leading-snug text-ink-2">{r.cells[k]}</dd>
          </div>
        ))}
      </dl>
    </div>
  ))}
</div>

<!-- Планшет и десктоп: таблица -->
<div class="card hidden overflow-hidden md:block">
  <div class="overflow-x-auto">
    <table class="w-full min-w-[880px] border-collapse text-left text-[14.5px]">
      <caption class="sr-only">{tr("Сравнение инвестиционных пакетов Stay Investment")}</caption>
      <thead>
        <tr class="border-b border-line">
          <th scope="col" class="sticky left-0 z-10 w-[16%] bg-surface px-5 py-5 text-[12.5px] font-bold uppercase tracking-[.12em] text-muted">{tr("Параметр")}</th>
          {COLS.map((c) => (
            <th scope="col" class="px-4 py-5 align-bottom">
              <span class="flex items-start gap-2"><span class="legend-key mt-1.5 shrink-0" style={`background:${c.color}`}></span><a href={c.href} class="text-[16px] font-extrabold leading-tight hover:text-brand-2">«{c.name}»</a></span>
              <span class="mt-1 block text-[13px] font-medium text-muted">{c.note}</span>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr class="border-b border-line last:border-0 even:bg-[#f7f7fd]">
            <th scope="row" class="sticky left-0 z-10 bg-inherit px-5 py-4 align-top font-bold">
              <span class="block">{r.label}</span>
              {r.hint && <span class="mt-0.5 block text-[12px] font-medium leading-snug text-muted">{r.hint}</span>}
            </th>
            {COLS.map((c) => <td class="px-4 py-4 align-top leading-snug text-ink-2">{r.cells[c.key]}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>
<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-pkg-tabs]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const select = (t: HTMLButtonElement) => {
      for (const x of tabs) {
        const on = x === t;
        x.setAttribute('aria-selected', String(on));
        x.tabIndex = on ? 0 : -1;
        root.querySelector<HTMLElement>(`[data-panel="${x.dataset.tab}"]`)!.hidden = !on;
      }
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => select(t));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (d) { const n = tabs[(i + d + tabs.length) % tabs.length]; select(n); n.focus(); }
      });
    });
  }
</script>
