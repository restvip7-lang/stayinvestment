---
/**
 * «Объект среди других в пакете»: точечная шкала (strip plot) по цене входа и, если есть, по доходности.
 * Текущий объект — цвет пакета (emphasis), остальные — серые; точки — ссылки на объекты. Подписаны мин., макс. и текущий.
 */
import { byPackage, entryPrice, yieldOf, objectUrl, euro, eurShort, pkgColor, PACKAGES, type InvestObject } from '../lib/catalog';
interface Props { o: InvestObject }
const { o } = Astro.props;
const peers = byPackage(o.package);
const scales = [
  { key: 'price', title: o.package === 'partnerskye' ? 'Сумма входа' : 'Стоимость входа', get: (x: InvestObject) => entryPrice(x), fmt: (n: number) => eurShort(n), full: (n: number) => euro(n), log: true },
  { key: 'yield', title: yieldOf(o)?.label ?? 'Доходность', get: (x: InvestObject) => yieldOf(x)?.value ?? null, fmt: (n: number) => `${n}%`, full: (n: number) => `${n}%`, log: false },
].map((s) => {
  const pts = peers.map((p) => ({ p, v: s.get(p) })).filter((x): x is { p: InvestObject; v: number } => x.v != null);
  const vs = pts.map((x) => x.v);
  const min = Math.min(...vs), max = Math.max(...vs);
  const f = (v: number) => (s.log ? Math.log(v) : v);
  const pos = (v: number) => (max === min ? 50 : ((f(v) - f(min)) / (f(max) - f(min))) * 100);
  const mine = s.get(o);
  const n = vs.length - 1;
  const below = mine == null ? 0 : vs.filter((v) => v < mine).length;
  const above = mine == null ? 0 : vs.filter((v) => v > mine).length;
  const equal = mine == null ? 0 : vs.filter((v) => v === mine).length;
  const note = equal > vs.length / 2
    ? `Как у большинства объектов пакета (${equal} из ${vs.length})`
    : s.key === 'price'
    ? (above === n ? 'Самый доступный вход в пакете' : below === n ? 'Самый крупный вход в пакете' : `Дешевле ${Math.round((above / n) * 100)}% объектов пакета`)
    : (below === n ? 'Максимум в пакете' : above === n ? 'Минимум в пакете' : `Выше, чем у ${Math.round((below / n) * 100)}% объектов пакета`);
  return { ...s, pts, min, max, pos, mine, note, distinct: new Set(vs).size };
}).filter((s) => s.mine != null && s.distinct > 1);
---
{scales.length > 0 && (
  <section class="card p-6 md:p-8" aria-labelledby="pos-title">
    <h2 id="pos-title" class="text-2xl">Объект среди других в пакете</h2>
    <p class="mt-1 text-[15px] text-ink-2">Каждая точка — объект пакета «{PACKAGES[o.package].name}» ({peers.length}). Этот объект выделен цветом; наведите на точку, чтобы увидеть детали.</p>
    <div class="mt-6 grid gap-8">
      {scales.map((s) => (
        <div>
          <div class="flex items-baseline justify-between gap-3">
            <p class="text-[14px] font-bold">{s.title}</p>
            <p class="text-[13px] text-muted">{s.note}</p>
          </div>
          <div class="relative mt-4 h-10">
            <div class="absolute inset-x-0 top-1/2 h-px bg-line-2"></div>
            {s.pts.filter((x) => x.p.id !== o.id).map((x) => (
              <a href={objectUrl(x.p)} class="absolute top-1/2 grid h-6 w-6 -translate-x-1/2 -translate-y-1/2 place-items-center rounded-full outline-none focus-visible:ring-2 focus-visible:ring-brand" style={`left:${s.pos(x.v)}%`} data-tip={`${s.full(x.v)}|${x.p.id} · ${x.p.title}`} aria-label={`${x.p.id}: ${s.full(x.v)}`}>
                <span class="h-2.5 w-2.5 rounded-full bg-[#b9bfca] ring-2 ring-surface"></span>
              </a>
            ))}
            <span class="absolute top-1/2 grid h-7 w-7 -translate-x-1/2 -translate-y-1/2 place-items-center" style={`left:${s.pos(s.mine!)}%`} tabindex="0" data-tip={`${s.full(s.mine!)}|Этот объект · ${o.id}`}>
              <span class="h-4 w-4 rounded-full ring-[3px] ring-surface" style={`background:${pkgColor(o.package)}`}></span>
            </span>
          </div>
          <div class="relative mt-1 h-5 text-[12px] text-muted">
            <span class="absolute left-0">{s.fmt(s.min)}</span>
            <span class="absolute right-0">{s.fmt(s.max)}</span>
          </div>
        </div>
      ))}
    </div>
    <p class="mt-2 text-[12.5px] text-muted">{scales.some((s) => s.log) ? 'Шкала цены — логарифмическая: равные расстояния означают одинаковую разницу в разах.' : ''}</p>
  </section>
)}
