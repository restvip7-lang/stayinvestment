---
import { langOf, useT } from '../i18n';
/**
 * Форма заявки. Отправляет JSON в /api/lead/ (дальше — вебхук LEAD_WEBHOOK_URL: CRM или Telegram).
 * source — откуда заявка (страница/блок), object — ID объекта, если форма в карточке.
 */
interface Props { source: string; object?: string; withComment?: boolean; button?: string; dark?: boolean; compact?: boolean }
const lang = langOf(Astro.locals);
const tr = useT(lang);
const { source, object, withComment = false, button = tr("Получить консультацию"), dark = false, compact = false } = Astro.props;
---
<form class:list={['lead-form grid gap-3', dark && 'on-dark']} data-lead-form novalidate>
  <input type="hidden" name="source" value={source} />
  {object && <input type="hidden" name="object" value={object} />}
  <input type="text" name="company" tabindex="-1" autocomplete="off" class="hidden" aria-hidden="true" />
  <div class:list={['grid gap-3', !compact && 'sm:grid-cols-2']}>
    <label class="block">
      <span class="sr-only">{tr("Имя")}</span>
      <input class="field" name="name" type="text" autocomplete="name" placeholder={tr("Ваше имя")} required minlength="2" />
    </label>
    <label class="block">
      <span class="sr-only">{tr("Телефон или WhatsApp")}</span>
      <input class="field" name="phone" type="tel" autocomplete="tel" inputmode="tel" placeholder={tr("Телефон / WhatsApp")} required pattern="[\d\s()+\-]{7,}" />
    </label>
  </div>
  {withComment && (
    <label class="block">
      <span class="sr-only">{tr("Комментарий")}</span>
      <textarea class="field" name="comment" placeholder={tr("Бюджет, цель инвестиций, удобное время для звонка")}></textarea>
    </label>
  )}
  <button type="submit" class="btn btn-accent w-full sm:w-auto">{button}</button>
  <p class:list={['text-[12.5px] leading-snug', dark ? 'text-white/80' : 'text-muted']}>{tr("Нажимая кнопку, вы соглашаетесь на обработку персональных данных. Ответим в течение рабочего дня.")}</p>
  <p class="hidden rounded-xl px-4 py-3 text-[14px] font-semibold" data-lead-status role="status" aria-live="polite"></p>
</form>
