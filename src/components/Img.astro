---
import { imgUrl, imgSrcset } from '../lib/img';
/**
 * Картинка: свои фото (/media) — готовые размеры 480/960/1600, внешние на Vercel — через его оптимизатор (src/lib/img.ts),
 * явные width/height против сдвига вёрстки, lazy ниже первого экрана. Нет файла или не загрузился — мягкий фон.
 */
interface Props { src?: string | null; alt: string; class?: string; sizes?: string; width?: number; height?: number; priority?: boolean }
const { src, alt, class: cls = '', sizes = '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw', width = 800, height = 600, priority = false } = Astro.props;
const srcset = src ? imgSrcset(src) : undefined;
---
{src
  ? <img src={imgUrl(src, 960)} srcset={srcset} sizes={srcset ? sizes : undefined} alt={alt} width={width} height={height} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} decoding="async" class:list={['img-fallback object-cover', cls]} onerror="this.removeAttribute('srcset');this.removeAttribute('src');this.style.visibility='hidden';this.parentElement&&this.parentElement.classList.add('img-fallback')" />
  : <div class:list={['img-fallback', cls]} role="img" aria-label={alt}></div>}
