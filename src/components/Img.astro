---
/**
 * Картинка: на проде внешние фото идут через оптимизатор Astro на сервере (/_image, WebP по ширине экрана),
 * явные width/height против сдвига вёрстки, lazy ниже первого экрана. Нет файла или не загрузился — мягкий фон.
 */
interface Props { src?: string | null; alt: string; class?: string; sizes?: string; width?: number; height?: number; priority?: boolean }
const { src, alt, class: cls = '', sizes = '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw', width = 800, height = 600, priority = false } = Astro.props;
const WIDTHS = [320, 640, 960, 1280, 1920];
const opt = import.meta.env.PROD && !!src && /^https:\/\//.test(src);
const u = (w: number) => `/_image?href=${encodeURIComponent(src!)}&w=${w}&q=75&f=webp`;
const srcset = opt ? WIDTHS.map((w) => `${u(w)} ${w}w`).join(', ') : undefined;
---
{src
  ? <img src={opt ? u(960) : src} srcset={srcset} sizes={opt ? sizes : undefined} alt={alt} width={width} height={height} loading={priority ? 'eager' : 'lazy'} fetchpriority={priority ? 'high' : undefined} decoding="async" class:list={['img-fallback object-cover', cls]} onerror="this.removeAttribute('srcset');this.removeAttribute('src');this.style.visibility='hidden';this.parentElement&&this.parentElement.classList.add('img-fallback')" />
  : <div class:list={['img-fallback', cls]} role="img" aria-label={alt}></div>}
